{
  "formatVersion": 1,
  "policies": {
    "standard": {
      "version": 1,
      "presets": [
        "size@1"
      ]
    },
    "vite-without-lockfile": {
      "version": 1,
      "presets": [
        "size@1"
      ],
      "defaults": {
        "paths": {
          "exclude": [
            "pnpm-lock.yaml"
          ]
        }
      }
    },
    "runtime-scopes": {
      "version": 1,
      "presets": [
        "size@1"
      ],
      "scopes": {
        "implementation": {
          "includeOnly": [
            "src/**"
          ],
          "exclude": [
            "**/tests/**"
          ]
        },
        "tests": {
          "includeOnly": [
            "**/tests/**"
          ]
        }
      },
      "metrics": {
        "implementationChanged": {
          "measure": "lines.changed",
          "scope": "implementation"
        },
        "testPathChanged": {
          "measure": "lines.changed",
          "scope": "tests"
        },
        "removedOrRewritten": {
          "formula": "totals.lines.deleted + totals.lines.modified"
        }
      }
    },
    "prettier-scopes": {
      "version": 1,
      "presets": [
        "size@1"
      ],
      "scopes": {
        "implementation": {
          "includeOnly": [
            "src/**"
          ]
        },
        "tests": {
          "includeOnly": [
            "tests/**"
          ]
        },
        "snapshots": {
          "includeOnly": [
            "tests/**/__snapshots__/**"
          ]
        }
      },
      "metrics": {
        "implementationChanged": {
          "measure": "lines.changed",
          "scope": "implementation"
        },
        "testChanged": {
          "measure": "lines.changed",
          "scope": "tests"
        },
        "snapshotChanged": {
          "measure": "lines.changed",
          "scope": "snapshots"
        }
      }
    },
    "comment-only": {
      "version": 1,
      "presets": [],
      "metrics": {
        "removedOrRewritten": {
          "formula": "totals.lines.deleted + totals.lines.modified"
        }
      },
      "rules": {
        "changeSummary": {
          "when": "true",
          "effects": {
            "comment": {
              "mode": "upsert",
              "trigger": "always",
              "template": "**Change summary**\n\nReplacement-aware changed lines: {{ totals.lines.changed }}\nRaw churn: {{ totals.raw.churn }}\nDeleted-only or modified lines: {{ metrics.removedOrRewritten }}\nIncluded files: {{ totals.files.included }}\n\nThese are diff measurements, not a judgment of quality or risk.\n"
            }
          }
        }
      }
    },
    "uv-without-executables": {
      "version": 1,
      "presets": [
        "size@1"
      ],
      "defaults": {
        "paths": {
          "exclude": [
            "crates/uv-trampoline/trampolines/uv-trampoline-aarch64-console.exe",
            "crates/uv-trampoline/trampolines/uv-trampoline-aarch64-gui.exe",
            "crates/uv-trampoline/trampolines/uv-trampoline-i686-console.exe",
            "crates/uv-trampoline/trampolines/uv-trampoline-i686-gui.exe",
            "crates/uv-trampoline/trampolines/uv-trampoline-x86_64-console.exe",
            "crates/uv-trampoline/trampolines/uv-trampoline-x86_64-gui.exe"
          ]
        }
      }
    },
    "prettier-bounded-proven": {
      "version": 1,
      "presets": [],
      "scopes": {
        "focus": {
          "includeOnly": [
            "tests/format/js/ternaries/__snapshots__/jsfmt.spec.js.snap"
          ]
        }
      },
      "metrics": {
        "focusChanged": {
          "measure": "lines.changed",
          "scope": "focus"
        }
      },
      "bands": {
        "focus": {
          "value": "metrics.focusChanged",
          "minimum": 0,
          "ranges": [
            {
              "id": "below-12000",
              "lt": 12000
            },
            {
              "id": "at-least-12000",
              "otherwise": true
            }
          ]
        }
      },
      "labelGroups": {
        "focus": [
          "example/below-12000",
          "example/at-least-12000"
        ]
      },
      "labelDefinitions": {
        "example/below-12000": {
          "color": "C5DEF5",
          "description": "Configured example band below 12,000 changed lines"
        },
        "example/at-least-12000": {
          "color": "D4C5F9",
          "description": "Configured example band at least 12,000 changed lines"
        }
      },
      "rules": {
        "focusBand": {
          "band": "focus",
          "onUnknown": "hold",
          "effects": {
            "labels": {
              "group": "focus",
              "byBand": {
                "below-12000": "example/below-12000",
                "at-least-12000": "example/at-least-12000"
              }
            }
          }
        }
      },
      "queries": {
        "above8000": {
          "expression": "metrics.focusChanged > 8000"
        },
        "above9500": {
          "expression": "metrics.focusChanged > 9500"
        },
        "above12000": {
          "expression": "metrics.focusChanged > 12000"
        }
      }
    },
    "prettier-bounded-held": {
      "version": 1,
      "presets": [],
      "scopes": {
        "focus": {
          "includeOnly": [
            "tests/format/js/ternaries/__snapshots__/jsfmt.spec.js.snap"
          ]
        }
      },
      "metrics": {
        "focusChanged": {
          "measure": "lines.changed",
          "scope": "focus"
        }
      },
      "bands": {
        "focus": {
          "value": "metrics.focusChanged",
          "minimum": 0,
          "ranges": [
            {
              "id": "below-9500",
              "lt": 9500
            },
            {
              "id": "at-least-9500",
              "otherwise": true
            }
          ]
        }
      },
      "labelGroups": {
        "focus": [
          "example/below-9500",
          "example/at-least-9500"
        ]
      },
      "labelDefinitions": {
        "example/below-9500": {
          "color": "C5DEF5",
          "description": "Configured example band below 9,500 changed lines"
        },
        "example/at-least-9500": {
          "color": "D4C5F9",
          "description": "Configured example band at least 9,500 changed lines"
        }
      },
      "rules": {
        "focusBand": {
          "band": "focus",
          "onUnknown": "hold",
          "effects": {
            "labels": {
              "group": "focus",
              "byBand": {
                "below-9500": "example/below-9500",
                "at-least-9500": "example/at-least-9500"
              }
            }
          }
        }
      },
      "queries": {
        "above8000": {
          "expression": "metrics.focusChanged > 8000"
        },
        "above9500": {
          "expression": "metrics.focusChanged > 9500"
        },
        "above12000": {
          "expression": "metrics.focusChanged > 12000"
        }
      }
    }
  }
}
