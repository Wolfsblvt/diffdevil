{
  "formatVersion": 1,
  "policies": {
    "standard": { "version": 1, "presets": ["size@1"] },
    "vite-without-lockfile": { "version": 1, "presets": ["size@1"], "defaults": { "paths": { "exclude": ["pnpm-lock.yaml"] } } },
    "runtime-scopes": { "version": 1, "presets": ["size@1"], "scopes": { "implementation": { "includeOnly": ["src/**"], "exclude": ["**/tests/**"] }, "tests": { "includeOnly": ["**/tests/**"] } }, "metrics": { "implementationChanged": { "measure": "lines.changed", "scope": "implementation" }, "testPathChanged": { "measure": "lines.changed", "scope": "tests" }, "removedOrRewritten": { "formula": "totals.lines.deleted + totals.lines.modified" } } },
    "prettier-scopes": { "version": 1, "presets": ["size@1"], "scopes": { "implementation": { "includeOnly": ["src/**"] }, "tests": { "includeOnly": ["tests/**"] }, "snapshots": { "includeOnly": ["tests/**/__snapshots__/**"] } }, "metrics": { "implementationChanged": { "measure": "lines.changed", "scope": "implementation" }, "testChanged": { "measure": "lines.changed", "scope": "tests" }, "snapshotChanged": { "measure": "lines.changed", "scope": "snapshots" } } },
    "comment-only": { "version": 1, "presets": [], "metrics": { "removedOrRewritten": { "formula": "totals.lines.deleted + totals.lines.modified" } }, "rules": { "changeSummary": { "when": "true", "effects": { "comment": { "mode": "upsert", "trigger": "always", "template": "**Change summary**\n\nReplacement-aware changed lines: {{ totals.lines.changed }}\nRaw churn: {{ totals.raw.churn }}\nDeleted-only or modified lines: {{ metrics.removedOrRewritten }}\nIncluded files: {{ totals.files.included }}\n\nThese are diff measurements, not a judgment of quality or risk.\n" } } } } },
    "uv-without-executables": { "version": 1, "presets": ["size@1"], "defaults": { "paths": { "exclude": ["crates/uv-trampoline/trampolines/uv-trampoline-aarch64-console.exe", "crates/uv-trampoline/trampolines/uv-trampoline-aarch64-gui.exe", "crates/uv-trampoline/trampolines/uv-trampoline-i686-console.exe", "crates/uv-trampoline/trampolines/uv-trampoline-i686-gui.exe", "crates/uv-trampoline/trampolines/uv-trampoline-x86_64-console.exe", "crates/uv-trampoline/trampolines/uv-trampoline-x86_64-gui.exe"] } } },
    "bounded-proven": { "version": 1, "presets": [], "metrics": { "changed": { "measure": "lines.changed" } }, "bands": { "example": { "value": "metrics.changed", "minimum": 0, "ranges": [{ "id": "below-100", "lt": 100 }, { "id": "at-least-100", "otherwise": true }] } }, "labelGroups": { "example": ["example/below-100", "example/at-least-100"] }, "labelDefinitions": { "example/below-100": { "color": "C5DEF5", "description": "Configured example band below 100 changed lines" }, "example/at-least-100": { "color": "D4C5F9", "description": "Configured example band at least 100 changed lines" } }, "rules": { "exampleBand": { "band": "example", "onUnknown": "hold", "effects": { "labels": { "group": "example", "byBand": { "below-100": "example/below-100", "at-least-100": "example/at-least-100" } } } } }, "queries": { "above50": { "expression": "totals.lines.changed > 50" }, "above65": { "expression": "totals.lines.changed > 65" }, "above70": { "expression": "totals.lines.changed > 70" } } },
    "bounded-held": { "version": 1, "presets": [], "metrics": { "changed": { "measure": "lines.changed" } }, "bands": { "example": { "value": "metrics.changed", "minimum": 0, "ranges": [{ "id": "below-65", "lt": 65 }, { "id": "at-least-65", "otherwise": true }] } }, "labelGroups": { "example": ["example/below-65", "example/at-least-65"] }, "labelDefinitions": { "example/below-65": { "color": "C5DEF5", "description": "Configured example band below 65 changed lines" }, "example/at-least-65": { "color": "D4C5F9", "description": "Configured example band at least 65 changed lines" } }, "rules": { "exampleBand": { "band": "example", "onUnknown": "hold", "effects": { "labels": { "group": "example", "byBand": { "below-65": "example/below-65", "at-least-65": "example/at-least-65" } } } } }, "queries": { "above50": { "expression": "totals.lines.changed > 50" }, "above65": { "expression": "totals.lines.changed > 65" }, "above70": { "expression": "totals.lines.changed > 70" } } }
  }
}
