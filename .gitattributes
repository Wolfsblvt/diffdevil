* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.zip binary

# Generated Action distribution is reviewed through its deterministic build and manifest.
actions/runtime/** -text linguist-generated=true
# Preserve original vendor notices and formatting instead of rewriting dependency bytes.
actions/runtime/node_modules/** -whitespace linguist-vendored=true
actions/analyze/index.mjs linguist-generated=true
actions/apply/index.mjs linguist-generated=true
actions/sync-labels/index.mjs linguist-generated=true
