{
  "language": "diffdevil-expr/1",
  "suite": "ast",
  "cases": [
    {
      "id": "multiplication-precedence",
      "source": "1+2*3",
      "expectAst": {
        "kind": "binary",
        "operator": "+",
        "left": {
          "kind": "literal",
          "literalType": "integer",
          "raw": "1",
          "value": 1,
          "span": {
            "start": 0,
            "end": 1
          }
        },
        "right": {
          "kind": "binary",
          "operator": "*",
          "left": {
            "kind": "literal",
            "literalType": "integer",
            "raw": "2",
            "value": 2,
            "span": {
              "start": 2,
              "end": 3
            }
          },
          "right": {
            "kind": "literal",
            "literalType": "integer",
            "raw": "3",
            "value": 3,
            "span": {
              "start": 4,
              "end": 5
            }
          },
          "span": {
            "start": 2,
            "end": 5
          },
          "operatorSpan": {
            "start": 3,
            "end": 4
          }
        },
        "span": {
          "start": 0,
          "end": 5
        },
        "operatorSpan": {
          "start": 1,
          "end": 2
        }
      }
    },
    {
      "id": "subtraction-left-associativity",
      "source": "10-3-2",
      "expectAst": {
        "kind": "binary",
        "operator": "-",
        "left": {
          "kind": "binary",
          "operator": "-",
          "left": {
            "kind": "literal",
            "literalType": "integer",
            "raw": "10",
            "value": 10,
            "span": {
              "start": 0,
              "end": 2
            }
          },
          "right": {
            "kind": "literal",
            "literalType": "integer",
            "raw": "3",
            "value": 3,
            "span": {
              "start": 3,
              "end": 4
            }
          },
          "span": {
            "start": 0,
            "end": 4
          },
          "operatorSpan": {
            "start": 2,
            "end": 3
          }
        },
        "right": {
          "kind": "literal",
          "literalType": "integer",
          "raw": "2",
          "value": 2,
          "span": {
            "start": 5,
            "end": 6
          }
        },
        "span": {
          "start": 0,
          "end": 6
        },
        "operatorSpan": {
          "start": 4,
          "end": 5
        }
      }
    }
  ]
}
