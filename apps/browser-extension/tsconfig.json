{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@wolfsblvt/diffdevil/browser": [
        "../../dist/lib/browser/index.d.ts"
      ],
      "@wolfsblvt/diffdevil/browser/text": [
        "../../dist/lib/browser/text.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
