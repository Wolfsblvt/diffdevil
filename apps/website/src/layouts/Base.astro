---
// SPDX-License-Identifier: AGPL-3.0-only
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COMPANY, COMPANY_SITE, ORIGIN, ORIGIN_IS_PLACEHOLDER } from '../data/site';
import { themeScript } from '../lib/theme-script.mjs';

interface Props {
  title: string; description: string;
  /** The short top-level section label shown beside the lockup; never an article title. */
  surface?: 'Playground' | 'Docs' | 'Examples' | 'GitHub App' | 'Extension' | 'FAQ' | 'App' | undefined; current?: string | undefined;
  /** Legal routes stay public and fetchable but out of search engines, snippets and the site's own search. */
  noindex?: boolean | undefined;
  /** False when the page supplies finer-grained global search records instead. */
  siteSearch?: boolean | undefined;
  /** An explicit social preview (1200×630, under /public) and its alt text; the product card otherwise. */
  image?: { path: string; alt: string } | undefined;
}
const { title, description, surface, current, noindex = false, siteSearch = true, image } = Astro.props;
const isHome = title === 'diffdevil';
const pageTitle = isHome ? 'diffdevil — The devil is in the diff.' : `${title} · diffdevil`;
const canonical = ORIGIN_IS_PLACEHOLDER ? undefined : `${ORIGIN}${Astro.url.pathname}`;
// Social projection: the page subject as og:title, the host site as og:site_name, one image with its size and alt.
const preview = image ?? { path: '/og.png', alt: 'diffdevil: The devil is in the diff. Measure changes. Match rules. Act on the result.' };
const previewUrl = `${ORIGIN}${preview.path}`;
// Small truthful structured identity on Home only: the site and its maker, nothing invented.
const identity = isHome && canonical ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'diffdevil', url: canonical, description, inLanguage: 'en', publisher: { '@type': 'Organization', name: COMPANY, url: COMPANY_SITE } }) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151922" />
    <meta name="color-scheme" content="dark light" />
    {noindex && <meta name="robots" content="noindex, nosnippet" />}
    {!noindex && <><meta property="og:site_name" content="diffdevil" />
    <meta property="og:title" content={isHome ? pageTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={preview.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={previewUrl} />
    <meta name="twitter:image:alt" content={preview.alt} /></>}
    {canonical && <link rel="canonical" href={canonical} />}
    {identity && <script type="application/ld+json" set:html={identity} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#f061ba" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline set:html={themeScript}></script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header surface={surface} current={current} />
    <main id="main" {...((noindex || !siteSearch) ? { 'data-pagefind-ignore': 'all' } : { 'data-pagefind-body': '' })}>
      <slot />
    </main>
    <Footer />
    <div class="live" role="status" aria-live="polite" data-live-region></div>
    <script>
      import '../lib/client';
    </script>
  </body>
</html>
