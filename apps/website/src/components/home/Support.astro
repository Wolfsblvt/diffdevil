---
// SPDX-License-Identifier: AGPL-3.0-only
// `#support`: the shared Wolfsblvt Works sponsor section, vendored from the Works bundle and bound by
// apps/website/works-sponsor.mjs. Works owns its words, artwork, corners and motion; diffdevil supplies the
// placement, the GitHub Sponsors and Ko-fi routes, the heading level, a unique id and the admitted host variables
// (the approved specimen's diffdevil values, mapped onto the site tokens so light and dark both hold).
// Common words only: no product-context line. A quiet star link stays outside the Works panel.
import template from '../../../../../vendor/brand/works/components/works-sponsor.html?raw';
import '../../../../../vendor/brand/works/css/works-sponsor.css';
import Icon from '../Icon.astro';
import { renderWorksSponsor } from '../../../works-sponsor.mjs';
import { copy } from '../../data/copy';
import { GITHUB, WORKS_SPONSORS } from '../../data/site';
const c = copy.support;
const html = renderWorksSponsor(template, { id: 'support-works', heading: 2, links: [...WORKS_SPONSORS] });
---
<section class="section" id="support" data-section="support" aria-label={c.label}>
  <div class="wrap">
    <div class="support-host" set:html={html} />
    <a class="support-star" href={GITHUB} rel="noopener" data-support-action="star"><Icon name="star" size={14} />{c.star}</a>
  </div>
</section>
<script>
  import { mountWorksSponsors } from '../../../../../vendor/brand/works/components/works-sponsor.mjs';
  mountWorksSponsors();
</script>
<style>
  .support-host {
    --works-sponsor-background: #151922; --works-sponsor-border: 1px solid #484d58; --works-sponsor-text: #f0f2f5;
    --works-sponsor-font: var(--font-ui); --works-sponsor-heading-font: 600 28px/1.15 var(--font-ui);
    --works-sponsor-button-background: var(--accent); --works-sponsor-button-text: var(--on-accent);
    --works-sponsor-radius-top-right: var(--r-card); --works-sponsor-radius-bottom-left: var(--r-card);
  }
  .support-host :global(.works-sponsor p) { color: #aab0bb; font-size: 15px; }
  .support-host :global(.works-sponsor .actions a) { border-radius: var(--r-control); font-size: 13.5px; min-height: 38px; }
  :global([data-theme="light"]) .support-host { --works-sponsor-background: var(--bg-raised); --works-sponsor-border: 1px solid var(--hair-strong); --works-sponsor-text: var(--fg); }
  :global([data-theme="light"]) .support-host :global(.works-sponsor p) { color: var(--fg-2); }
  .support-star { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: 13.5px; color: var(--fg-2); }
  .support-star:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
</style>
