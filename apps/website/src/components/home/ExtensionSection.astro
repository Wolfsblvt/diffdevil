---
// SPDX-License-Identifier: AGPL-3.0-only
// `#extension`, directly after `#measure`: here is what Changed means → here is that exact
// meaning inside GitHub. One broad fixture-backed pull-request scene with the report shown
// open, three short explanatory blocks, and two actions: Add to Chrome goes straight to
// the Store, the product wording goes to /extension/.
import ActionLink from '../ActionLink.astro';
import Icon from '../Icon.astro';
import Scene from '../extension/Scene.astro';
import SectionHead from '../SectionHead.astro';
import { copy } from '../../data/copy';
import { CHROME_WEB_STORE_URL, paths } from '../../data/site';
const c = copy.extension;
---
<section class="section" data-section="extension">
  <div class="wrap">
    <SectionHead id="extension" title={c.h2} body={c.body} />
    <Scene />
    <ul class="ext-columns">
      {c.columns.map(([title, body]) => <li><strong>{title}</strong><span>{body}</span></li>)}
    </ul>
    <div class="ext-actions">
      <ActionLink class="btn btn-primary" href={CHROME_WEB_STORE_URL} data-cta="add-to-chrome">{c.add}<Icon name="external" size={11} /></ActionLink>
      <a class="ext-explore" href={paths.extension}>{c.explore} →</a>
      <span class="ext-trust">{c.trust}</span>
    </div>
  </div>
</section>
<style>
  .ext-columns { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 28px; font-size: 13.5px; }
  .ext-columns li { display: flex; flex-direction: column; gap: 2px; color: var(--fg-2); }
  .ext-columns strong { color: var(--fg); font-weight: 700; }
  .ext-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .ext-explore { font-size: 13.5px; font-weight: 600; }
  .ext-explore:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ext-trust { margin-left: auto; font-size: 12.5px; color: var(--fg-3); }
  @media (max-width: 900px) { .ext-columns { grid-template-columns: minmax(0, 1fr); } .ext-trust { margin-left: 0; flex-basis: 100%; } }
</style>
