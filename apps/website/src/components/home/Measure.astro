---
// SPDX-License-Identifier: AGPL-3.0-only
// #measure: text beside the large metric composition. The composition is one machine
// panel in three columns: policy-focus metric, decomposition, raw contrast. Words are
// grey; decomposition numbers are white; raw stays grey throughout.
import SectionHead from '../SectionHead.astro';
import SectionLinks from '../SectionLinks.astro';
import { copy } from '../../data/copy';
import { paths } from '../../data/site';
import { display, evidenceGlyph } from '../../lib/engine-node';
import { measureSpecimen } from '../../lib/specimens';
const { report, result, observed, excluded } = measureSpecimen();
const review = report.metrics!.review!;
const band = result.rules.size?.band;
const label = band?.status === 'resolved' ? `size/${band.id.toUpperCase()}` : 'size/Unknown';
const lines = report.totals.lines, raw = report.totals.raw, files = report.totals.files;
const c = copy.measure;
const number = (value: number) => new Intl.NumberFormat('en').format(value);
---
<section class="section" data-section="measure">
  <div class="wrap">
    <div class="measure-grid">
      <SectionHead id="measure" title={c.h2} body={c.body} />
      <figure class="machine measure-panel">
        <figcaption class="machine-head measure-head"><span>{c.panelHead}</span><span>{display(files.total!)} files · {display(files.included!)} included · {display(files.excluded!)} excluded</span></figcaption>
        <div class="measure-cell primary result-frame">
          <p class="label">{c.primaryLabel}</p>
          <p class="primary-value"><span class="metric-xl">{display(review)}</span><span class="metric-unit">changed</span></p>
          <p class="pills"><span class="chip-ev" data-status={review.status}>{evidenceGlyph[review.status]} {review.status}</span><span class="chip-meta">lines.changed</span></p>
          <p class="result-line">band {band?.status === 'resolved' ? band.id : '?'} → <span class="label-swatch" style="background:#C5DEF5">{label}</span></p>
        </div>
        <div class="measure-cell">
          <p class="label">{c.decomposition}</p>
          <ul class="facts facts-strong">
            <li><span>+ added-only</span><span class="v">{display(lines.added)}</span></li>
            <li><span>− deleted-only</span><span class="v">{display(lines.deleted)}</span></li>
            <li><span>~ modified</span><span class="v">{display(lines.modified)}</span></li>
          </ul>
        </div>
        <div class="measure-cell">
          <p class="label">{c.raw}</p>
          <ul class="facts">
            <li><span>+ additions</span><span class="v">{display(raw.added)}</span></li>
            <li><span>− deletions</span><span class="v">{display(raw.deleted)}</span></li>
            <li><span>churn</span><span class="v">{display(raw.churn)}</span></li>
          </ul>
        </div>
        <div class="machine-foot measure-foot">
          {excluded.map(file => <p>▣ <code>{file.path}</code> excluded by <code>{file.inclusionReasons?.[0]?.subject ?? 'defaults.paths.exclude'}</code> — observed churn would be {number(observed.churn)}.</p>)}
          <p><a class="try-link" href={`${paths.playground}?example=lockfile-scope&variant=without-lockfile`}>{c.tryIt} →</a></p>
        </div>
      </figure>
    </div>
    <SectionLinks links={c.links} />
  </div>
</section>
<style>
  .measure-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 48px; align-items: start; }
  .measure-grid :global(.heading) { margin: 12px 0; }
  .measure-panel { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr); }
  .measure-head, .measure-foot { grid-column: 1 / -1; }
  .measure-head { padding: 10px 20px; font-size: 12px; flex-wrap: nowrap; white-space: nowrap; }
  .measure-head span { overflow: hidden; text-overflow: ellipsis; }
  .measure-cell { padding: 22px 16px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .measure-cell + .measure-cell { border-left: 1px solid #2c303a; }
  .primary { padding-bottom: 24px; text-align: center; }
  .primary-value { margin: 0; display: flex; align-items: baseline; justify-content: center; gap: 12px; }
  .pills { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px; margin: 0; }
  .result-line { margin: 0; font-family: var(--font-mono); font-size: 12.5px; color: #b4b7be; display: flex; align-items: center; gap: 8px; }
  .measure-cell .facts { font-size: 15px; line-height: 2; white-space: nowrap; }
  .measure-cell .facts li { gap: 14px; }
  .measure-foot { display: flex; flex-direction: column; gap: 4px; padding: 10px 20px; }
  .measure-foot p { margin: 0; }
  .measure-foot code { font-size: 12px; }
  .try-link { color: #828690; }
  .try-link:hover { color: #f0f2f5; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1100px) { .measure-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  @media (max-width: 640px) {
    .measure-panel { grid-template-columns: minmax(0, 1fr); }
    .measure-cell + .measure-cell { border-left: 0; border-top: 1px solid #2c303a; }
    .measure-cell:not(.primary) { align-items: stretch; }
    .measure-head { white-space: normal; flex-wrap: wrap; }
  }
</style>
