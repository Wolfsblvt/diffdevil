---
// SPDX-License-Identifier: AGPL-3.0-only
// Four typographic cells. The example values are read from the repository's exact,
// bounded, incomplete and unmeasurable report specimens through the engine.
import SectionHead from '../SectionHead.astro';
import { copy } from '../../data/copy';
import { display, readRepositoryFile, reportFromSaved } from '../../lib/engine-node';
const c = copy.evidence;
const specimens = {
  exact: reportFromSaved(readRepositoryFile('docs/examples/reports/exact.json')),
  bounded: reportFromSaved(readRepositoryFile('docs/examples/reports/bounded.json')),
  unknown: reportFromSaved(readRepositoryFile('docs/examples/reports/incomplete.json')),
  unmeasurable: reportFromSaved(readRepositoryFile('docs/examples/reports/unmeasurable.json')),
} as const;
const value = (status: keyof typeof specimens): string => display(specimens[status].totals.lines.changed);
---
<section class="section" id="evidence">
  <div class="wrap">
    <SectionHead id="evidence" title={c.h2} body={c.body} links={[c.link]} />
    <div class="cells">
      {c.cells.map(cell => (
        <div class="cell">
          <p class="cell-head"><span class="chip-ev" data-status={cell.status}>{cell.glyph} {cell.word}</span><span class="mono cell-value">{value(cell.status as keyof typeof specimens)}</span></p>
          <p class="cell-text">{cell.text}</p>
          <p class="caption mono">docs/examples/reports/{cell.status === 'unknown' ? 'incomplete' : cell.status}.json · totals.lines.changed</p>
        </div>
      ))}
    </div>
    <p class="lede foot">{c.foot}</p>
  </div>
</section>
<style>
  .cells { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--hair); border-bottom: 1px solid var(--hair); }
  .cell { padding: 22px 20px; border-right: 1px solid var(--hair); display: grid; gap: 10px; align-content: start; }
  .cell:last-child { border-right: 0; }
  .cell-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0; }
  .cell-value { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cell-text { margin: 0; font-size: 13.5px; color: var(--fg-2); }
  .foot { margin-top: 22px; max-width: 720px; }
  @media (max-width: 900px) { .cells { grid-template-columns: 1fr 1fr; } .cell:nth-child(2) { border-right: 0; } .cell:nth-child(-n+2) { border-bottom: 1px solid var(--hair); } }
  @media (max-width: 640px) { .cells { grid-template-columns: 1fr; } .cell { border-right: 0; border-bottom: 1px solid var(--hair); } .cell:last-child { border-bottom: 0; } }
</style>
