---
// SPDX-License-Identifier: AGPL-3.0-only
// Three panels with arrows: § Configured → Proposed ⟲ Applied + readback. The proposed
// panel is a real desired plan for the teaching patch; the readback panel is the copy
// deck's illustration of an explicit apply, labelled as such.
import SectionHead from '../SectionHead.astro';
import { copy } from '../../data/copy';
import { readSpecimen, policySpecimen } from '../../lib/specimens';
const c = copy.policy;
const { plan } = policySpecimen();
const policyExcerpt = readSpecimen('fullPolicy').split('\n').filter(line => !line.startsWith('#')).slice(0, 12).join('\n') + '\n…';
const ops = plan.operations.map(op => {
  if (op.kind === 'label.select') return `label.select  ${op.group}: ${op.selected}  (managed: ${op.members.join(', ')})`;
  if (op.kind === 'comment.reconcile') return `comment.reconcile  ${op.rule}: ${op.mode}, trigger ${op.trigger}`;
  return `${op.kind}  ${op.name}`;
});
---
<section class="section" id="policy">
  <div class="wrap">
    <SectionHead id="policy" title={c.h2} body={c.body} links={c.links} />
    <div class="policy-grid">
      <article class="machine col">
        <header class="code-head"><span class="lane">{c.col1[0]}</span><span class="spacer"></span><span>{c.col1[1]} · {c.col1[2]}</span></header>
        <pre class="code-body"><code>{policyExcerpt}</code></pre>
      </article>
      <span class="arrow" aria-hidden="true">→</span>
      <article class="machine col">
        <header class="code-head"><span class="lane">{c.col2[0]}</span><span class="spacer"></span><span>{c.col2[1]} · {c.col2[2]}</span></header>
        <pre class="code-body"><code>{`stage: ${plan.stage}\ntarget: ${plan.target.repository}#${plan.target.pullRequest}\n\n`}{ops.join('\n')}{plan.held.length ? `\n\nheld: ${plan.held.map(h => h.rule).join(', ')}` : ''}{'\n\nNo provider effects were applied.'}</code></pre>
      </article>
      <span class="arrow" aria-hidden="true">→</span>
      <article class="machine col">
        <header class="code-head"><span class="lane" data-lane="readback">{c.col3[0]}</span><span class="spacer"></span><span>{c.col3[1]} · {c.col3[2]}</span></header>
        <pre class="code-body"><code>{c.col3Body.map(line => <span class={line.startsWith('+') ? 'add' : line.startsWith('−') ? 'del' : ''}>{line}{'\n'}</span>)}</code></pre>
        <p class="col-note">Illustration of an explicit <code>apply</code>. Readback is observed provider state; the playground never shows it as applied.</p>
      </article>
    </div>
  </div>
</section>
<style>
  .policy-grid { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 12px; align-items: stretch; }
  .col { display: flex; flex-direction: column; }
  .col .code-body { flex: 1; }
  .col .add { color: var(--diff-add); } .col .del { color: var(--diff-del); }
  .arrow { align-self: center; font-family: var(--font-mono); font-size: 22px; color: var(--fg-3); }
  .col-note { margin: 0; padding: 10px 14px; border-top: 1px solid #2c303a; font-size: 12px; color: #828690; }
  .col-note code { color: #a9b8cc; }
  @media (max-width: 900px) { .policy-grid { grid-template-columns: 1fr; } .arrow { justify-self: center; transform: rotate(90deg); } }
</style>
