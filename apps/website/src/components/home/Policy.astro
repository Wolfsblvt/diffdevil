---
// SPDX-License-Identifier: AGPL-3.0-only
// #policy: a directional sequence in three different voices. § Configured is YAML the
// reader owns; → Proposed is the plan document as data; ⟲ Applied + readback is what an
// explicit apply reports as text. The first two are projections of the real full.yml and
// of the real plan the engine creates for exact.json under it (excerpts: identifiers and
// unrelated keys are left out, nothing is altered). The third is the copy deck's
// illustration of an apply run, which a static page cannot perform.
import { Code } from 'astro:components';
import SectionHead from '../SectionHead.astro';
import SectionLinks from '../SectionLinks.astro';
import { copy } from '../../data/copy';
import { diffdevilSyntax } from '../../lib/shiki-theme';
import { policySpecimen } from '../../lib/specimens';
const c = copy.policy;
const { document, plan } = policySpecimen();

const band = document.bands.size, rule = document.rules.size;
const flow = (entries: Record<string, unknown>): string => `{ ${Object.entries(entries).map(([key, value]) => `${key}: ${value}`).join(', ')} }`;
// Lines are broken by hand at the width of one column (about 40 characters at the reference
// width), so the excerpts read as authored code instead of soft-wrapping mid-token.
function pairs<T>(items: readonly T[]): T[][] {
  const rows: T[][] = [];
  items.forEach((item, index) => { if (index % 2) rows.at(-1)!.push(item); else rows.push([item]); });
  return rows;
}
const byBand = pairs(Object.entries(rule.effects.labels.byBand as Record<string, string>).map(([id, label]) => `${id}: ${label}`));
const pad = ' '.repeat('        byBand: { '.length);
const configured = [
  'bands:', '  size:', `    value: ${band.value}`, '    ranges:',
  ...band.ranges.map((range: Record<string, unknown>) => `    - ${flow(range)}`),
  'rules:', '  size:', `    band: ${rule.band}`, '    effects:', '      labels:', `        group: ${rule.effects.labels.group}`,
  ...byBand.map((row, index) => `${index === 0 ? '        byBand: { ' : pad}${row.join(', ')}${index === byBand.length - 1 ? ' }' : ','}`),
].join('\n');

const q = JSON.stringify;
const size = plan.rules.size!;
const operations = plan.operations.map(op => {
  if (op.kind !== 'label.select') return [`    { "kind": ${q(op.kind)},`, `      "name": ${q('name' in op ? op.name : '')} }`].join('\n');
  const members = pairs(op.members.map(member => q(member)));
  const indent = ' '.repeat(8);
  return [`    { "kind": ${q(op.kind)},`, `      "group": ${q(op.group)},`, `      "selected": ${q(op.selected)},`,
    ...members.map((row, index) => `${index === 0 ? '      "members": [' : indent}${row.join(', ')}${index === members.length - 1 ? '] }' : ','}`)].join('\n');
});
const proposed = [
  `{ "kind": ${q(plan.kind)},`, `  "stage": ${q(plan.stage)},`, '  "rules": { "size": {',
  ...(size.band?.status === 'resolved'
    ? [`    "band": { "id": ${q(size.band.id)},`, `              "lower": ${size.band.lower}, "upper": ${size.band.upper} },`]
    : ['    "band": { "status": "unknown" },']),
  `    "disposition": ${q(size.disposition)} } },`, '  "operations": [', operations.join(',\n'), '  ] }',
].join('\n');
---
<section class="section" data-section="policy">
  <div class="wrap">
    <SectionHead id="policy" title={c.h2} body={c.body} />
    <div class="policy-grid">
      <article class="policy-col">
        <header class="policy-head"><span>{c.col1[0]} · {c.col1[1]}</span><span>{c.col1[2]}</span></header>
        <Code class="policy-body" code={configured} lang="yaml" theme={diffdevilSyntax} wrap />
      </article>
      <span class="arrow" aria-hidden="true">→</span>
      <article class="policy-col">
        <header class="policy-head"><span>{c.col2[0]} · {c.col2[1]}</span><span>{c.col2[2]}</span></header>
        <Code class="policy-body" code={proposed} lang="json" theme={diffdevilSyntax} wrap />
      </article>
      <span class="arrow" aria-hidden="true">→</span>
      <article class="policy-col policy-col-strong">
        <header class="policy-head"><span>{c.col3[0]} · {c.col3[1]}</span><span>{c.col3[2]}</span></header>
        <pre class="policy-body diff"><code>{c.col3Body.map(line => <span class={line.trimStart().startsWith('+') ? 'add' : line.trimStart().startsWith('−') ? 'del' : ''}>{line}{'\n'}</span>)}</code></pre>
        <p class="policy-note">{c.col3Note}</p>
      </article>
    </div>
    <SectionLinks links={c.links} />
  </div>
</section>
<style>
  .policy-grid { display: grid; grid-template-columns: minmax(0, 1fr) 34px minmax(0, 1fr) 34px minmax(0, 1fr); align-items: stretch; }
  .policy-col { border: 1px solid var(--hair); border-radius: var(--r-card); overflow: hidden; background: var(--bg-raised); display: flex; flex-direction: column; min-width: 0; }
  .policy-col-strong { border-color: var(--hair-strong); }
  .policy-head { padding: 10px 16px; border-bottom: 1px solid var(--hair); display: flex; justify-content: space-between; gap: 4px 6px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 11.5px; color: var(--fg-3); }
  .policy-col :global(.policy-body) { margin: 0; padding: 14px 16px; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; color: #f0f2f5; flex: 1; background: var(--bg-machine) !important; white-space: pre-wrap; overflow-wrap: anywhere; overflow: visible; color-scheme: dark; }
  .policy-note { margin: 0; padding: 8px 16px; border-top: 1px solid #2c303a; background: var(--bg-machine); font-size: 12px; color: #828690; }
  .arrow { display: flex; align-items: center; justify-content: center; font-size: 22px; color: var(--fg-3); }
  @media (max-width: 1000px) { .policy-grid { grid-template-columns: minmax(0, 1fr); } .arrow { padding: 6px 0; transform: rotate(90deg); } }
</style>
