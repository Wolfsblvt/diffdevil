---
// SPDX-License-Identifier: AGPL-3.0-only
// #query: one full-width machine surface, two terminal columns. Command in --term-cmd,
// returned output in --term-out. Every command is executed by the real CLI at build
// (lib/cli-specimen.ts) on the input the header names; the surface prints that stdout and
// exit code. Rows are contiguous like a real session, and every command fits its column
// at the reference width; below it, lines wrap the way a terminal wraps.
import SectionHead from '../SectionHead.astro';
import SectionLinks from '../SectionLinks.astro';
import { copy } from '../../data/copy';
import { headerOf, runCli } from '../../lib/cli-specimen';
import { files } from '../../lib/specimens';

interface Row { readonly cmd: string; readonly out: readonly string[]; readonly comment?: string | undefined }
const c = copy.query;
const over = runCli(['check', '--metric', 'changed', '--gt', '100'], [0, 1]);
const under = runCli(['check', '--metric', 'changed', '--gt', '1000'], [0, 1]);
const json = runCli(['analyze', '--format', 'json']);
const agent = runCli(['analyze', '--format', 'agent']);
// What `jq -c .totals.lines.changed` prints for that JSON document.
const changed = JSON.stringify(JSON.parse(json.stdout).totals.lines.changed);

const left: Row[] = [
  { cmd: 'diffdevil query --expr metrics.review --format value', out: runCli(['query', '--expr', 'metrics.review', '--format', 'value']).lines },
  { cmd: 'diffdevil query --files --select path --format lines', out: runCli(['query', '--files', '--select', 'path', '--format', 'lines']).lines },
  { cmd: 'diffdevil check --metric changed --gt 100 && echo over', out: over.code === 0 ? ['over'] : [] },
  { cmd: 'diffdevil check --metric changed --gt 1000; echo $?', out: [String(under.code)], comment: under.code === 1 ? '# false, not an error' : undefined },
];
const right: Row[] = [
  { cmd: 'diffdevil analyze --format json | jq -c .totals.lines.changed', out: [changed] },
  { cmd: 'diffdevil query --files --metric changed --gt 100 --select path', out: runCli(['query', '--files', '--metric', 'changed', '--gt', '100', '--select', 'path']).lines },
  { cmd: 'diffdevil analyze --format agent', out: [...headerOf(agent), '…'] },
];
---
<section class="section" data-section="query">
  <div class="wrap">
    <SectionHead id="query" title={c.h2} body={c.body} />
    <figure class="machine query-panel">
      <figcaption class="machine-head query-head"><span>{files.exactReport} · policy full.yml</span><span>shell</span></figcaption>
      {[left, right].map(rows => (
        <pre class="terminal query-terminal"><code>{rows.map(row => <><span class="p">$ </span><span class="c">{row.cmd}</span>{'\n'}{row.out.map((line, index) => <>{line}{row.comment && index === row.out.length - 1 ? <span class="cm">{'   '}{row.comment}</span> : null}{'\n'}</>)}</>)}</code></pre>
      ))}
      <p class="query-foot"><span>{c.foot}</span><span>{c.foot2}</span></p>
    </figure>
    <SectionLinks links={c.links} />
  </div>
</section>
<style>
  .query-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .query-head, .query-foot { grid-column: 1 / -1; }
  .query-head { padding-inline: 24px; }
  .query-terminal { padding: 20px 24px; font-size: 13.5px; line-height: 1.75; }
  .query-terminal + .query-terminal { border-left: 1px solid #2c303a; }
  .query-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 22px; margin: 0; padding: 10px 24px; border-top: 1px solid #2c303a; font-family: var(--font-mono); font-size: 12px; color: #828690; }
  @media (max-width: 1100px) {
    .query-panel { grid-template-columns: minmax(0, 1fr); }
    .query-terminal + .query-terminal { border-left: 0; border-top: 1px solid #2c303a; }
  }
  @media (max-width: 640px) { .query-terminal { font-size: 12px; padding: 16px; } }
</style>
