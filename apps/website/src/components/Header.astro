---
// SPDX-License-Identifier: AGPL-3.0-only
// The one site header, identical on every route including the manual: brand (+ a plain
// surface label, never a link) on the left; search, navigation, socials, theme and the
// npm command as one right-aligned cluster, npm right-most. Geometry comes from `.wrap`,
// so the lockup sits at the same coordinate on every page.
import Icon from './Icon.astro';
import Search from './Search.astro';
import Socials from './Socials.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { copy } from '../data/copy';
import { paths } from '../data/site';
interface Props { surface?: string | undefined; current?: string | undefined }
const { surface, current } = Astro.props;
const items = [
  { href: paths.docs, label: copy.nav.docs, key: 'docs' },
  { href: paths.playground, label: copy.nav.playground, key: 'playground' },
  { href: paths.examples, label: copy.nav.examples, key: 'examples' },
  { href: paths.app, label: copy.nav.app, key: 'app', github: true },
] as const;
---
<header class="site-header" data-site-header>
  <div class="wrap">
    <div class="brand">
      <a class="brand-link" href="/" aria-label="diffdevil home">
        <span class="logo logo-lockup" role="img" aria-label="diffdevil"></span>
        <span class="logo logo-micro brand-micro" role="img" aria-label="diffdevil"></span>
      </a>
      {surface && <span class="surface-title" data-surface-label>{surface}</span>}
    </div>
    <div class="header-cluster">
      <Search />
      <nav aria-label="Site"><ul class="site-nav" id="site-nav">
        {items.map(item => (
          <li><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{'github' in item && <Icon name="github" size={14} />}{item.label}</a></li>
        ))}
      </ul></nav>
      <span class="header-sep" aria-hidden="true"></span>
      <Socials place="header" />
      <span class="header-sep" aria-hidden="true"></span>
      <ThemeSwitch />
      <button class="install-chip" type="button" data-copy={copy.nav.install} aria-label={`Copy install command: ${copy.nav.install}`}>
        <span>{copy.nav.install}</span><Icon name="copy" size={13} class="copy-glyph" />
      </button>
      <button class="btn btn-quiet menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>{copy.a11y.menu}</button>
    </div>
  </div>
</header>
