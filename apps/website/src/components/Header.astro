---
// SPDX-License-Identifier: AGPL-3.0-only
// The one site header, identical on every route including the manual. It applies the
// Wolfsblvt Works header grammar:
//
//   [brand + section label] [search]  Docs Playground Examples Install⌄ │ [GitHub] [Community⌄] [Theme] [one action]
//
// Identity → discovery → navigation → one divider → utilities → one trailing action.
// · The section label sits outside the home link and is plain text.
// · Install⌄ and Community⌄ are disclosures of ordinary links (button + aria-expanded),
//   not ARIA menus; one panel is open at a time (lib/client.ts). Install lists site pages
//   only; install actions live on those pages.
// · Compact: search shrinks first, then the whole primary navigation collapses into Menu⌄
//   in the navigation's own place. GitHub, Community and Theme never move into it.
// · The trailing slot holds exactly one action: the npm copy command until a real
//   Dashboard destination is configured, then Dashboard (the command stays in Install).
import Icon from './Icon.astro';
import Search from './Search.astro';
import ThemeControl from './ThemeControl.astro';
import DestinationRows from './DestinationRows.astro';
import InstallEntries from './InstallEntries.astro';
import { copy } from '../data/copy';
import { community } from '../data/destinations';
import { DASHBOARD_URL, GITHUB, paths } from '../data/site';
interface Props { surface?: string | undefined; current?: string | undefined }
const { surface, current } = Astro.props;
const here = Astro.url.pathname;
const links = [
  { href: paths.docs, label: copy.nav.docs, key: 'docs' },
  { href: paths.playground, label: copy.nav.playground, key: 'playground' },
  { href: paths.examples, label: copy.nav.examples, key: 'examples' },
] as const;
const installCurrent = current === 'app' || current === 'extension';
---
<header class="site-header" data-site-header>
  <div class="wrap">
    <div class="brand">
      <a class="brand-link" href="/" aria-label="diffdevil home">
        <span class="logo logo-lockup" role="img" aria-label="diffdevil"></span>
        <span class="logo logo-micro brand-micro" role="img" aria-label="diffdevil"></span>
      </a>
      {surface && <span class="surface-title" data-surface-label>{surface}</span>}
    </div>
    <div class="header-main">
      <Search />
      <nav class="primary-nav" aria-label="Site">
        <ul class="site-nav">
          {links.map(item => (
            <li><a href={item.href} aria-current={item.href === here ? 'page' : undefined} data-in-section={current === item.key ? '' : undefined}><span class="nav-label" data-label={item.label}>{item.label}</span></a></li>
          ))}
          <li class="disclosure-host">
            <button class="nav-disclosure" type="button" aria-expanded="false" aria-controls="panel-install" data-panel-trigger data-in-section={installCurrent ? '' : undefined}><span class="nav-label" data-label={copy.nav.install}>{copy.nav.install}</span><Icon name="chevron" size={10} class="chevron" /></button>
            <div class="dest-panel" id="panel-install" data-panel data-align="start" hidden>
              <InstallEntries kind="install" />
            </div>
          </li>
        </ul>
      </nav>
      <div class="disclosure-host compact-menu">
        <button class="menu-trigger" type="button" aria-expanded="false" aria-controls="panel-menu" data-panel-trigger>{copy.nav.menu}<Icon name="chevron" size={10} class="chevron" /></button>
        <div class="dest-panel" id="panel-menu" data-panel data-align="start" hidden>
          <ul class="dest-rows">
            {links.map(item => <li><a class="dest-row dest-row-plain" href={item.href} aria-current={item.href === here ? 'page' : undefined}><span class="dest-label">{item.label}</span></a></li>)}
          </ul>
          <p class="dest-heading">{copy.nav.install}</p>
          <InstallEntries kind="menu" />
        </div>
      </div>
      <span class="header-sep" aria-hidden="true"></span>
      <div class="utilities">
        <a class="utility utility-direct" href={GITHUB} rel="noopener" aria-label={copy.nav.source} title={copy.nav.source} data-direct-source><Icon name="github" size={16} /></a>
        <div class="disclosure-host">
          <button class="utility utility-social" type="button" aria-expanded="false" aria-controls="panel-community" aria-label={copy.community.trigger} title={copy.community.tooltip} data-panel-trigger><Icon name="social-links" size={16} /><Icon name="chevron" size={10} class="chevron" /></button>
          <div class="dest-panel" id="panel-community" data-panel data-align="end" hidden>
            <p class="dest-heading">{copy.community.heading}</p>
            <DestinationRows rows={community} kind="community" />
          </div>
        </div>
        <ThemeControl />
      </div>
      {DASHBOARD_URL
        ? <a class="trailing-action" href={DASHBOARD_URL} data-trailing="dashboard">{copy.nav.dashboard}</a>
        : <button class="trailing-action trailing-copy" type="button" data-copy={copy.nav.command} data-copy-state aria-label={`Copy install command: ${copy.nav.command}`} data-trailing="npm">
            <span class="copy-swap"><span class="copy-swap-rest">{copy.nav.command}</span><span class="copy-swap-done" aria-hidden="true">{copy.nav.copied}</span></span>
            <Icon name="copy" size={13} class="copy-glyph" />
          </button>}
    </div>
  </div>
</header>
