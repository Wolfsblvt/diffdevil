---
// SPDX-License-Identifier: AGPL-3.0-only
// The Install destinations, used by the desktop Install⌄ panel and the compact Menu⌄
// panel alike. It is a menu of the site's own pages and nothing else: every entry is one
// whole-row link with a title and a short description, browser extension first. Direct
// install actions ("Add to Chrome", "Install on GitHub") deliberately do not live here;
// they are on the pages these rows lead to and on the homepage.
import DestinationRows from './DestinationRows.astro';
import { copy } from '../data/copy';
import type { IconName } from '../data/icons';
import { docPaths, paths } from '../data/site';
interface Props { kind: string }
const { kind } = Astro.props;
const here = Astro.url.pathname;
const c = copy.install;
const entries: { id: string; icon: IconName; label: string; note: string; href: string }[] = [
  { id: 'extension', icon: 'chrome', label: c.extension[0], note: c.extension[1], href: paths.extension },
  { id: 'app', icon: 'github', label: c.app[0], note: c.app[1], href: paths.app },
  { id: 'open', icon: 'cli', label: c.open[0], note: c.open[1], href: docPaths.getStarted },
];
const rows = entries.map(row => ({ ...row, current: row.href === here }));
---
<DestinationRows rows={rows} kind={kind} />
