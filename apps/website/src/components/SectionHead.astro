---
// SPDX-License-Identifier: AGPL-3.0-only
// Section heading. The literal `#id` eyebrow IS the anchor: it carries the id, scrolls into
// place under the sticky header, and is a link to itself. The magenta `#` after the title
// is the same link for pointer users. Hovering or focusing either lights both.
// Cross-links never live here; they close the section through SectionLinks.
interface Props { id: string; title: string; body?: string | undefined; as?: 'h1' | 'h2' | undefined; small?: boolean | undefined }
const { id, title, body, as: Tag = 'h2', small = false } = Astro.props;
---
<div class:list={['section-head', 'anchor-group', { 'section-head-small': small }]}>
  <p class="eyebrow"><slot name="before" /><a class="eyebrow-link" id={id} href={`#${id}`}>#{id}</a><slot name="after" /></p>
  <div class="heading">
    <Tag class="h2">{title}</Tag>
    <a class="permalink" href={`#${id}`} tabindex="-1" aria-hidden="true">#</a>
  </div>
  {body && <p class="lede">{body}</p>}
  <slot />
</div>
