---
// SPDX-License-Identifier: AGPL-3.0-only
// Literal `#id` eyebrow, h2 with a keyboard-reachable permalink, lede and contextual links.
import { copy } from '../data/copy';
import { docPaths } from '../data/site';
interface Props { id: string; eyebrow?: string | undefined; title: string; body?: string | undefined; links?: ReadonlyArray<readonly [string, string]> | undefined; wide?: boolean | undefined }
const { id, eyebrow = `#${id}`, title, body, links = [], wide = false } = Astro.props;
const resolve = (key: string): string => (docPaths as Record<string, string>)[key] ?? key;
---
<div class:list={['section-head', { 'section-head-wide': wide }]}>
  <p class="eyebrow">{eyebrow}</p>
  <div class="heading">
    <h2 class="h2">{title}</h2>
    <a class="permalink" href={`#${id}`} aria-label={copy.a11y.permalink}>#</a>
  </div>
  {body && <p class="lede">{body}</p>}
  {links.length > 0 && <ul class="links">{links.map(([label, key]) => <li><a class="link" href={resolve(key)}>{label}</a></li>)}</ul>}
</div>
<style>
  .section-head-wide { max-width: none; }
</style>
