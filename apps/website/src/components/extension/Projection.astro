---
// SPDX-License-Identifier: AGPL-3.0-only
// One diffdevil for GitHub seat, as the extension renders it in GitHub's own diffstat
// slot (Extension Grammar v1 §4, §8): [glyph] Changed N  +a −d ~m  [size chip]  rail  local.
// The visible word "Changed" always stays on the aggregate seat. The rail has one cell
// per configured band and only marks a position in that ordinal scale; it is not a
// score. A file seat carries the value and the triplet only: a file has no band, no
// chip and no provenance. Values are passed in from the engine; nothing is computed here.
import Icon from '../Icon.astro';
interface Props {
  changed: string; added: string; deleted: string; modified: string;
  bands: readonly { id: string; label: string | undefined }[]; band: string | undefined;
  standing?: string | undefined; compact?: boolean | undefined;
}
const { changed, added, deleted, modified, bands, band, standing = 'local', compact = false } = Astro.props;
const selected = bands.find(item => item.id === band);
const chip = compact ? undefined : selected?.label ?? band;
---
<span class:list={['ddx', { 'ddx-compact': compact }]}>
  <span class="ddx-main">
    <Icon name="brand" size={compact ? 14 : 16} class="ddx-glyph" />
    {!compact && <span class="ddx-word">Changed</span>}
    <strong class="ddx-total">{changed}</strong>
    <span class="ddx-parts"><span class="ddx-add">+{added}</span> <span class="ddx-del">−{deleted}</span> <span class="ddx-mod">~{modified}</span></span>
    {chip && <span class="ddx-chip"><span class="ddx-swatch" aria-hidden="true"></span>{chip}</span>}
  </span>
  {!compact && bands.length > 0 && (
    <span class="ddx-rail" role="img" aria-label={`Band ${band}, position ${bands.findIndex(item => item.id === band) + 1} of ${bands.length}`}>
      {bands.map(item => <span class:list={['ddx-cell', { 'is-selected': item.id === band }]}></span>)}
    </span>
  )}
  {!compact && standing && <span class="ddx-standing">{standing}</span>}
</span>
<style>
  .ddx { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; font-size: 12px; line-height: 20px; font-variant-numeric: tabular-nums; }
  .ddx-main { display: inline-flex; align-items: center; gap: 8px; }
  .ddx :global(.ddx-glyph) { color: var(--gh-fg, #e6edf3); }
  .ddx-compact :global(.ddx-glyph) { color: var(--gh-muted, #8b949e); }
  .ddx-word { font-weight: 600; }
  .ddx-total { font-size: 14px; font-weight: 650; }
  .ddx-compact .ddx-total { font-size: 13px; }
  .ddx-parts { display: inline-flex; gap: 6px; white-space: nowrap; }
  .ddx-add { color: var(--gh-add, #3fb950); }
  .ddx-del { color: var(--gh-del, #f85149); }
  .ddx-mod { color: var(--gh-fg, #e6edf3); }
  .ddx-chip { display: inline-flex; align-items: center; gap: 6px; padding: 0 8px; border: 1px dashed var(--gh-border, #30363d); border-radius: 2em; font-size: 12px; font-weight: 500; line-height: 18px; white-space: nowrap; }
  .ddx-swatch { width: 8px; height: 8px; border-radius: 2px; background: #c5def5; }
  .ddx-rail { display: inline-flex; gap: 2px; width: 56px; height: 9px; }
  .ddx-cell { flex: 1; border: 1px solid var(--gh-border, #30363d); border-radius: 1px; background: var(--gh-raised, #161b22); }
  .ddx-cell.is-selected { background: #c5def5; border-color: var(--gh-fg, #e6edf3); }
  .ddx-standing { color: var(--gh-muted, #8b949e); }
</style>
