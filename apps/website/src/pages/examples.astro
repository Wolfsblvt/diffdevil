---
// SPDX-License-Identifier: AGPL-3.0-only
// /examples/: the shared real-PR lessons, grouped by their first declared lesson.
// Cards and their variants both carry the exact Playground state that replays them.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import { copy } from '../data/copy';
import { paths } from '../data/site';
import { catalogue } from '../lib/catalogue';
import { display, evaluate, evidenceGlyph, policyFromYaml } from '../lib/engine-node';

const examples = catalogue();
const cards = examples.entries.map(entry => ({
  ...entry,
  variants: entry.variants.map(variant => {
    const result = evaluate(policyFromYaml(variant.policyText, variant.policyId), variant.report);
    const [owner, repo] = variant.repository.split('/');
    return { ...variant, owner, repo, band: result.report.bands?.size, files: display(variant.report.fileSet.total), churn: display(variant.report.totals.raw.churn), changed: display(result.report.metrics?.review ?? result.report.totals.lines.changed) };
  }),
}));
const groups = Object.values(Object.groupBy(cards, card => card.lessons[0] ?? 'other'));
const c = copy.examples;
---
<Base title={c.title} description="Real public pull requests, each picked for one lesson about measuring a change, analyzed by the same engine as the diffdevil CLI and Actions." surface="Examples" current="examples">
  <h1 class="visually-hidden">{c.title}</h1>
  <section class="section section-first" data-section="how">
    <div class="wrap">
      <SectionHead id="how" title={c.howTitle} body={c.how} small />
      <p class="caption how-note">{c.howNote}</p>
    </div>
  </section>
  <section class="section" data-section="pull-requests">
    <div class="wrap">
      <SectionHead id="pull-requests" title={c.realTitle} body={c.realBody} small />
      {groups.map(group => <section class="ex-group">
        <h2>{group![0]!.lessons[0]}</h2>
        <ul class="ex-grid">
          {group!.map(card => (
            <li class="card ex-card">
              <h3 class="ex-lesson">{card.title}</h3>
              <p class="ex-teaches">{card.summary}</p>
              <ul class="ex-variants">
                {card.variants.map(variant => <li>
                  <div class="ex-head">
                    <h4 class="ex-title"><Icon name="github" size={16} class="ex-icon" /><a class="link-plain" href={variant.url} rel="noopener"><span class="ex-owner">{variant.owner}/</span>{variant.repo} <span class="ex-number">#{variant.pullRequest}</span></a></h4>
                    <span class="chip-ev" data-status={variant.report.measurement.status}>{evidenceGlyph[variant.report.measurement.status]} {variant.report.measurement.status}</span>
                  </div>
                  <p class="ex-pr-title">{variant.label} · {variant.title}</p>
                  <p class="ex-numbers"><span><strong class="tabular">{variant.changed}</strong> changed</span><span>churn {variant.churn}</span><span>{variant.files} files</span>{variant.band && <span>band {variant.band.status === 'resolved' ? variant.band.id : '?'}</span>}</p>
                  <p class="caption ex-meta">{variant.edition} · snapshot {variant.head.slice(0, 7)} · captured {variant.capturedAt.slice(0, 10)} · policy {variant.policyId}</p>
                  <div class="ex-actions"><a class="btn btn-primary" href={`${paths.playground}?example=${card.id}&variant=${variant.id}`}>{c.open}</a><a class="ex-latest" href={`${paths.playground}?example=${card.id}&variant=${variant.id}&head=live`}>{copy.playground.analyzeLatest} →</a></div>
                </li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>)}
    </div>
  </section>
</Base>
<style>
  .section-first { border-top: 0; padding-block: 40px 32px; }
  .how-note { margin: 0; }
  .ex-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .ex-card { display: flex; flex-direction: column; gap: 8px; }
  .ex-group + .ex-group { margin-top: 36px; }
  .ex-group > h2 { margin: 0 0 14px; font-size: 14px; text-transform: capitalize; }
  .ex-lesson { margin: 0; font-size: 17px; }
  .ex-variants { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 16px; }
  .ex-variants > li + li { border-top: 1px solid var(--line); padding-top: 16px; }
  .ex-head { display: flex; align-items: center; justify-content: space-between; gap: 6px 12px; flex-wrap: wrap; }
  .ex-title { display: inline-flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ex-title :global(.ex-icon) { color: var(--fg-3); }
  .ex-owner { color: var(--fg-3); font-weight: 500; }
  .ex-number { font-variant-numeric: tabular-nums; }
  .ex-head .chip-ev { margin-left: auto; }
  .ex-pr-title { margin: 0 0 10px; font-weight: 600; font-size: 14.5px; }
  .ex-why, .ex-teaches { margin: 0; font-size: 13px; color: var(--fg-2); }
  .ex-why strong { color: var(--fg); }
  .ex-numbers { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-family: var(--font-mono); font-size: 12.5px; align-items: baseline; color: var(--fg-2); }
  .ex-numbers strong { font-size: 18px; color: var(--fg); }
  .ex-meta { margin: 0; font-family: var(--font-mono); }
  .ex-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; margin-top: auto; padding-top: 6px; }
  .ex-latest { font-size: 13px; color: var(--fg-2); }
  .ex-latest:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1000px) { .ex-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .ex-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
