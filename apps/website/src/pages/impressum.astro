---
// SPDX-License-Identifier: AGPL-3.0-only
// /impressum/: the legal-notice route owned by the diffdevil site. The route, its footer
// link and legal standing are shared with the manual. Operator fields are projected
// at build time; ordinary qualification uses the explicit non-publication fixture.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import LegalOperator from '../components/LegalOperator.astro';
import { COMPANY, COMPANY_LEGAL_NOTICE, paths } from '../data/site';
---
<Base title="Impressum" description="Legal notice for the diffdevil website." current="impressum" noindex>
  <section class="section section-first">
    <article class="wrap legal">
      <SectionHead id="impressum" as="h1" title="Impressum" />
      <p class="lede">Provider information pursuant to § 5 DDG for diffdevil and its website.</p>
      <LegalOperator contact="impressum" />
      <p class="small">{COMPANY} is the maker and publisher name. The person named above is the operator. See also the <a class="link-quiet" href={COMPANY_LEGAL_NOTICE} rel="noopener">Company legal notice</a>.</p>
      <p class="small">Data processing and your rights: <a class="link-quiet" href={paths.privacy}>Privacy and data</a>. Hosted-service scope: <a class="link-quiet" href={paths.terms}>Terms</a>.</p>
    </article>
  </section>
</Base>
<style>
  .section-first { border-top: 0; padding-block: 40px 96px; }
  .legal { gap: 12px !important; }
  .legal > :global(*) { max-width: 760px; }
  .legal p.small { margin: 0; color: var(--fg-2); }
</style>
