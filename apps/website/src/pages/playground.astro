---
// SPDX-License-Identifier: AGPL-3.0-only
// The dedicated playground page. The shared header already names the surface, so the page
// carries no title block: the workbench starts directly under the header bar, on the same
// page grid as every other route. The island is the justified interactive part. The rail
// lists the curated real pull requests and opens on the first of them; controlled fixtures
// stay addressable by ?example= for the homepage link and the qualification run, and are
// not offered as a list.
import Base from '../layouts/Base.astro';
import Playground from '../islands/playground/Playground.tsx';
import { copy } from '../data/copy';
import { DEFAULT_FIXTURE } from '../../catalogue/fixtures.mjs';
import { curated } from '../lib/catalogue';
import '../styles/playground.css';

const curatedCards = curated().map(entry => ({ id: entry.id, group: 'curated' as const, title: entry.title, repository: entry.repository, pullRequest: entry.pullRequest, reason: entry.reason, head: entry.head, analyzedAt: entry.analyzedAt, evidence: entry.evidence }));
---
<Base title={copy.playground.title} description="Read-only diffdevil playground: analyze a public pull request or a curated example and see the same result as terminal, data, GitHub preview and explanation." surface="Playground" current="playground">
  <h1 class="visually-hidden">{copy.playground.title}</h1>
  <p class="visually-hidden">{copy.playground.sub}</p>
  <div class="wrap pg-wrap">
    <Playground client:only="react" curated={curatedCards} defaultExample={curatedCards[0]?.id ?? DEFAULT_FIXTURE} />
  </div>
</Base>
