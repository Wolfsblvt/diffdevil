---
// SPDX-License-Identifier: AGPL-3.0-only
// The dedicated playground page. The shared header already names the surface, so the page
// carries no title block: the workbench starts directly under the header bar, on the same
// page grid as every other route. The island is the justified interactive part. The rail
// lists the shared catalogue's real pull-request lessons and opens its declared default.
import Base from '../layouts/Base.astro';
import Playground from '../islands/playground/Playground.tsx';
import { copy } from '../data/copy';
import { catalogue } from '../lib/catalogue';
import '../styles/playground.css';

const examples = catalogue();
const catalogueCards = examples.entries.map(entry => ({
  id: entry.id,
  title: entry.title,
  lessons: entry.lessons,
  summary: entry.summary,
  variants: entry.variants.map(variant => ({
    id: variant.id,
    label: variant.label,
    repository: variant.repository,
    pullRequest: variant.pullRequest,
    head: variant.head,
    capturedAt: variant.capturedAt,
    edition: variant.edition,
    evidence: variant.report.measurement.status,
  })),
}));
---
<Base title={copy.playground.title} description="Read-only diffdevil playground: analyze a public pull request or replay a saved real-PR lesson through terminal, data, GitHub preview and explanation." surface="Playground" current="playground">
  <h1 class="visually-hidden">{copy.playground.title}</h1>
  <p class="visually-hidden">{copy.playground.sub}</p>
  <div class="wrap pg-wrap">
    <Playground client:only="react" catalogue={catalogueCards} defaultExample={examples.defaultExample} />
  </div>
</Base>
