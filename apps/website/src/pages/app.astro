---
// SPDX-License-Identifier: AGPL-3.0-only
// /app/: the public GitHub App page. Same engine, less plumbing. The head is the same
// AppPanel the homepage shows, then the real Overview, a tour of the destinations in actual
// App captures, why, plans, history, permissions, hosted versus self-hosted, and migration
// from an existing Action writer. Each chapter is a short lead, its blocks
// on the page grid below it, and its cross-links as the closing row. The captures are the
// real signed-in App on its sample fixture; plans follow docs/app-plans.md; the App contract
// in the manual is authoritative.
import Base from '../layouts/Base.astro';
import AppPanel from '../components/AppPanel.astro';
import ProductShot from '../components/ProductShot.astro';
import overview from '../assets/app/overview.png';
import prs from '../assets/app/prs.png';
import historyShot from '../assets/app/history.png';
import prDetail from '../assets/app/pr-detail.png';
import manage from '../assets/app/manage-repositories.png';
import { availability } from '../data/availability';
import Icon from '../components/Icon.astro';
import { copy } from '../data/copy';
import CodeBlock from '../components/CodeBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import SectionLinks from '../components/SectionLinks.astro';
import { blobUrl, docPaths, paths } from '../data/site';
const permissions = [
  ['Contents', 'read', 'trusted repository policy (.diffdevil.yml from the PR base) and relative comment templates'],
  ['Pull requests', 'write', 'PR acquisition and the selected label / owned-comment effects'],
  ['Checks', 'write', 'one App-owned check summary per analyzed head, updated rather than duplicated'],
];
const history = [
  ['What it shows', 'What merged and when, how big each pull request was, how long it took, and how this period compares with the last. Pro adds which files keep changing, grow or change together.'],
  ['What is kept', 'Repository names, relative file paths, numerical measurements, comparison identities, lifecycle facts and coverage. Names and paths are protected repository metadata, not anonymous data.'],
  ['What is never kept', 'No source contents, patches, contributor-performance dimensions, PR prose or full reports. History uses an explicit allowlist; a new report field does not become stored data by accident.'],
  ['Yours to control', 'Choose the repositories that collect it and, if you like, a shorter retention. Export the numbers in a documented format, stop collection, or delete what exists; deleted ranges are not recreated.'],
];
const shots = copy.app.shots;
/** A tour stop is already named by its label; its lead is the caption without the "Name: " prefix. */
const lead = (caption: string): string => caption.replace(/^[^:]+:\s*/u, '').replace(/^./u, letter => letter.toUpperCase());
const tour = [
  { id: 'prs', name: 'Pull requests', src: prs, shot: shots.prs, points: ['Opened against merged and closed per week, with the open backlog', 'Lifecycle by size: draft, review and merge time', 'Size mix under the policy you run today'] },
  { id: 'history', name: 'History', src: historyShot, shot: shots.history, points: ['Change volume split into modified, added-only and deleted-only', 'Every merged pull request placed by size band', 'Period against period, with bounded evidence kept visible'] },
  { id: 'pr', name: 'Pull request detail', src: prDetail, shot: shots.prDetail, points: ['Replacement-aware Changed beside raw churn', 'The policy result, the label it wants and the label GitHub shows', 'How the size moved across analysed heads'] },
  { id: 'manage', name: 'Manage', src: manage, shot: shots.manage, points: ['Choose which repositories run, label-only or with history', 'Account defaults, linked policies, people and audit', 'Plan and funding for each account and organisation'] },
] as const;
// The hosted offer exactly as docs/app-plans.md selects it. Checkout opens with the App's public access.
const plans = [
  { name: 'Free', price: '€0', cadence: 'for everyone', annual: '', fit: 'For your own projects and small public ones.', lead: 'Checks, size labels and the history of your pull requests.',
    items: ['Native checks, size labels and size replies', 'Up to 3 private repositories, any number of public ones', 'Pull-request size, lifecycle and repository history', 'History on up to 10 public repositories, 30 rolling days'] },
  { name: 'Pro', price: '€9', cadence: 'per month', annual: 'or €90 a year (€7.50 a month)', fit: 'For people who want to understand their codebase.', lead: 'Everything in Free, plus file-level memory.',
    items: ['No limit on your own repositories', 'File history, clouds, Turnover and co-change', 'History without automatic age expiry', 'One organisation included, with 3 private repositories'] },
  { name: 'Business', price: '€42', cadence: 'per month', annual: 'or €400 a year (€33.33 a month)', fit: 'For teams that run policy across an organisation.', lead: 'Everything in Pro, coordinated across teams.',
    items: ['One organisation included, without repository limits', 'Shared named policies, linked and applied in bulk', 'Eligible repositories set up automatically', 'Delegated administration with a full audit'] },
] as const;
// Capability by plan, condensed from docs/app-plans.md: true is included, false is not, a string is the limit.
type Cell = boolean | string;
const compare: readonly { group: string; rows: readonly (readonly [string, Cell, Cell, Cell])[] }[] = [
  { group: 'Pull requests', rows: [
    ['Native checks, size labels and size replies', true, true, true],
    ['Unmetered: no pull-request budget, no per-PR charge', true, true, true],
  ] },
  { group: 'Repositories', rows: [
    ['Private repositories', 'Up to 3', 'Unlimited', 'Unlimited'],
    ['Public repositories', 'Unlimited', 'Unlimited', 'Unlimited'],
    ['Public repositories with history', 'Up to 10', 'Unlimited', 'Unlimited'],
    ['Organisation included', 'Shares the Free limits', '3 private repositories', 'Unlimited'],
    ['More organisations', false, '+€9/month each', '+€9/month each'],
  ] },
  { group: 'History', rows: [
    ['Pull-request size, lifecycle and history', true, true, true],
    ['How long history is kept', '30 days', 'No expiry', 'No expiry'],
    ['Historical import', '100 recent PRs', 'All recoverable', 'All recoverable'],
    ['File history, clouds, Turnover and co-change', false, true, true],
  ] },
  { group: 'Policy and teams', rows: [
    ['Repository policy', true, true, true],
    ['Default policy per account and organisation', false, true, true],
    ['Shared policies, linking and bulk apply', false, false, true],
    ['Automatic repository setup', false, false, true],
    ['Delegated administration and full audit', false, false, true],
    ['Readers without seats', true, true, true],
  ] },
];
/** A cell a higher plan adds over the plan before it gets the gain highlight. */
const gains = (row: readonly Cell[], index: number): boolean => index > 0 && row[index] !== false && row[index] !== row[index - 1];
const migration = `# 1. Turn off the Action writer. A read-only step may stay.
- uses: Wolfsblvt/diffdevil/actions/analyze@v1
# 2. Install the App and pick the same preset.
# 3. Your .diffdevil.yml keeps winning.`;
---
<Base title="GitHub App" image={{ path: '/og-app.png', alt: 'diffdevil: The App runs for the repository. Same diffdevil, less plumbing. Beside it, the App Overview across several repositories.' }} description="The diffdevil GitHub App runs the same engine and .diffdevil.yml as the Action for the repositories you choose: native checks and size labels, then Overview, pull-request flow, history and Manage across your repositories. Hosted or self-hosted." surface="GitHub App" current="app">
  <section class="section section-first" data-section="app">
    <div class="wrap">
      <AppPanel as="h1" secondaryHref="#tour" selfHostHref="#self-host" />
      <ProductShot src={overview} alt={shots.overview.alt} title={copy.app.shotTitle} caption={`${shots.overview.caption} ${copy.app.shotStanding}`} eager />
      {!availability.app.open && <aside class="notice-proposed" role="note"><strong>{availability.app.status}</strong> {availability.app.note} Everything on this page describes the implemented App. The CLI, Actions and Playground work today without it.</aside>}
    </div>
  </section>

  <section class="section" data-section="tour">
    <div class="wrap">
      <SectionHead id="tour" title="Read your repositories, not just one pull request" body="Six destinations over the same retained facts: Overview, Pull requests, History, Files, and the detail of a single pull request or file. Every view is a URL, every chart has a table view, and every number says whether it is exact, bounded or unknown." />
      <ol class="tour">
        {tour.map((stop, index) => (
          <li class:list={['tour-stop', { 'tour-flip': index % 2 === 1 }]} id={`tour-${stop.id}`}>
            <div class="tour-text">
              <p class="label">{stop.name}</p>
              <p class="tour-lead">{lead(stop.shot.caption)}</p>
              <ul class="small plain-list">{stop.points.map(point => <li>{point}</li>)}</ul>
            </div>
            <ProductShot src={stop.src} alt={stop.shot.alt} title={copy.app.shotTitle} sizes="(max-width: 1000px) 100vw, 760px" />
          </li>
        ))}
      </ol>
      <div class="panel tour-files">
        <p class="label">Files <span class="plan-chip">Pro</span></p>
        <p class="small tour-files-body">File history, clouds, Turnover and co-change: which files keep changing, grow, or change together. It reads the same retained measurements, never source contents, and is part of Pro and Business.</p>
      </div>
      <SectionLinks links={[['App architecture', docPaths.app], ['Managed service', docPaths.service]]} />
    </div>
  </section>

  <section class="section" data-section="plans">
    <div class="wrap">
      <SectionHead id="plans" title="Free, Pro and Business" body="Free for your own projects. Pay for file-level memory of your codebase, or for policy across an organisation." />
      <div class="plans">
        {plans.map(plan => (
          <div class:list={['panel', 'plan', { 'plan-mid': plan.name === 'Pro' }]}>
            <p class="label">{plan.name}</p>
            <p class="plan-price"><strong>{plan.price}</strong><span>{plan.cadence}</span></p>
            <p class="plan-annual small">{plan.annual || '\u00a0'}</p>
            <p class="small plan-fit">{plan.fit}</p>
            <p class="small plan-lead">{plan.lead}</p>
            <ul class="small plan-list">{plan.items.map(item => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <caption class="visually-hidden">Capabilities by plan</caption>
          <thead><tr><th scope="col"><span class="compare-note">{availability.app.open ? 'Prices in EUR, incl. tax' : 'Paid plans open with public access · EUR, incl. tax'}</span></th>{plans.map(plan => <th scope="col" class:list={{ 'is-pro': plan.name === 'Pro' }}><span class="compare-plan">{plan.name}</span><span class="compare-price">{plan.price}{plan.name !== 'Free' && <small>/month</small>}</span></th>)}</tr></thead>
          {compare.map(({ group, rows }) => (
            <tbody>
              <tr class="compare-group"><th scope="rowgroup" colspan="4">{group}</th></tr>
              {rows.map(row => (
                <tr>
                  <th scope="row">{row[0]}</th>
                  {[row[1], row[2], row[3]].map((cell, index, cells) => (
                    <td class:list={{ 'is-pro': index === 1, 'is-gain': gains(cells, index) }}>
                      {cell === true ? <span class="compare-yes"><Icon name="included" size={14} /><span class="visually-hidden">Included</span></span>
                        : cell === false ? <span class="compare-no"><Icon name="not-included" size={14} /><span class="visually-hidden">Not included</span></span>
                        : cell}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <SectionLinks links={[['Plans and account management', docPaths.service], ['Hosted by us or self-hosted', '#self-host']]} />
    </div>
  </section>

  <section class="section" data-section="history">
    <div class="wrap">
      <SectionHead id="history" title="History that remembers every change" body="The App keeps the size, lifecycle and measurements of every pull request in the repositories you choose, so you can see what merged, how big it was, how long it took and how that compares with last period. It is a record of numbers and paths, never an archive of your code, and an administrator turns it on per repository." />
      <div class="history-grid">
        {history.map(([title, body]) => <div class="panel"><p class="label">{title}</p><p class="small history-body">{body}</p></div>)}
      </div>
      <p class="history-standing small">Free keeps thirty rolling days. Pro and Business keep history without automatic age expiry while the plan and the service stay active, subject to your deletion and disclosed limits.</p>
      <SectionLinks links={[['Privacy and data', docPaths.privacyAndData]]} />
    </div>
  </section>

  <section class="section" data-section="why">
    <div class="wrap">
      <SectionHead id="why" title="Why choose the App" body="Both routes run the same engine and the same policy. The difference is who operates it: a workflow you assemble and maintain, or an installation that stays current." />
      <div class="grid-2">
        <div class="panel choice">
          <p class="label">Run the Action yourself</p>
          <ul class="small plain-list">
            <li><code class="code-inline">.github/workflows/size.yml</code> with <code class="code-inline">pull_request_target</code> and <code class="code-inline">pull-requests: write</code></li>
            <li>a token boundary you keep separate from trusted policy reads</li>
            <li>runner minutes on every PR event, plus <code class="code-inline">@v1</code> upgrades</li>
            <li>label definitions created by the first run</li>
          </ul>
        </div>
        <div class="panel choice choice-app">
          <p class="label">Use the App <span class="choice-tag">✓ less to operate</span></p>
          <ul class="small plain-list">
            <li>installed on the repositories you choose, nothing in the workflow tree</li>
            <li>presets and account or organization defaults, below your repository file</li>
            <li>one native check summary per analyzed head</li>
            <li>labels only in declared groups, comments only when opted in, readback after every write</li>
            <li>history across your repositories: numbers and paths, never content</li>
          </ul>
        </div>
      </div>
      <SectionLinks links={[['App architecture', docPaths.app], ['Configuration layering', `${docPaths.configure}#know-which-host-supplies-each-layer`]]} />
    </div>
  </section>

  <section class="section" data-section="permissions">
    <div class="wrap">
      <SectionHead id="permissions" title="Permissions" body="Three permissions, each with one concrete operation. The App never executes pull-request code and never trusts PR-head policy for writes." />
      <div class="perms-wrap">
        <table class="perms">
          <thead><tr><th>Permission</th><th>Access</th><th>Used for</th></tr></thead>
          <tbody>{permissions.map(([name, access, use]) => <tr><td>{name}</td><td><code class="code-inline">{access}</code></td><td>{use}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="caption perms-foot">No Issues, Actions, Administration or broader repository write permission. Dashboard sign-in authenticates a person separately and never becomes the background credential.</p>
      <SectionLinks links={[['Permissions and current access', `${docPaths.privacyAndData}#authorization-and-writes-in-the-app`]]} />
    </div>
  </section>

  <section class="section" data-section="self-host">
    <div class="wrap">
      <SectionHead id="self-host" title="Hosted by us or self-hosted" body={`The Community App is open source under AGPL-3.0-only, in the same repository as the engine.${availability.app.open ? "" : " The official hosted service opens with public access."} Pro and Business include separately maintained private extensions; Community self-hosting needs neither a subscription nor those modules.`} />
      <div class="grid-2">
        <div class="panel">
          <p class="label">Self-hosting needs</p>
          <ul class="small plain-list">
            <li>your own GitHub App registration with the three permissions above</li>
            <li>a Cloudflare Worker, Queue and D1 database (the first supported adapter), plus the webhook secret, App ID and private key as secrets</li>
            <li>the runtime source under <code class="code-inline">apps/github-app/</code>, its migration, and its maintenance path</li>
            <li>no diffdevil branding that implies the official service</li>
          </ul>
          <SectionLinks class="panel-links" links={[['Self-hosting the runtime', docPaths.selfHost], ['Runtime source', blobUrl('apps/github-app/README.md')], ['Licence boundaries', paths.licences]]} />
        </div>
        <div class="panel">
          <p class="label">Data</p>
          <p class="small data-body">Managed automation keeps a seven-day operational recovery ledger. Persistent history requires explicit enablement and retains permitted repository names, relative paths and numerical facts. Source contents, patches, PR prose and full reports are not retained as history. GitHub access still governs who may read it.</p>
          <SectionLinks class="panel-links" links={[['Privacy and data', docPaths.privacyAndData]]} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-section="migrate">
    <div class="wrap">
      <div class="migrate-grid">
        <SectionHead id="migrate" title="Already running the Action?" body="Two writers must not own the same labels. Disable the Action writer before enabling overlapping App effects. The App never adopts another actor's comments; a read-only analyze step can stay beside it." />
        <CodeBlock code={migration} lang="yaml" file="migration outline" copy={false} />
      </div>
      <SectionLinks links={[['Comment ownership and migration', `${docPaths.service}#move-between-actions-and-the-app`], ['Actions manual', docPaths.actions]]} />
    </div>
  </section>

  <section class="section" id="carried" hidden data-carried>
    <div class="wrap">
      <div class="notice-proposed"><strong>A policy was carried from the playground.</strong> Nothing from that anonymous session is kept here. When the App is open for installation, setup asks you to install and authorize on GitHub first; until then, save the policy as <code class="code-inline">.diffdevil.yml</code> at your repository root, where both the Action and the App read it.</div>
    </div>
  </section>
  <script>
    // The playground's export hands a policy over in the URL only; reveal the note, keep nothing.
    if (new URLSearchParams(location.search).has('policy')) document.querySelector<HTMLElement>('[data-carried]')!.hidden = false;
  </script>
</Base>
<style>
  .section-first { border-top: 0; }
  .panel .label { margin: 0 0 8px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .panel :global(.panel-links) { margin-top: 12px; font-size: 13px; gap: 6px 18px; }
  /* equal weight; the App route carries one restrained positive signal: glyph + word + edge */
  .choice-app { border-left: 3px solid var(--status-success); }
  .choice-tag { color: var(--status-success); text-transform: none; letter-spacing: 0; font-size: 11.5px; }
  :global([data-theme="light"]) .choice-app { border-left-color: var(--status-success-light); }
  :global([data-theme="light"]) .choice-tag { color: var(--status-success-light); }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .choice-app { border-left-color: var(--status-success-light); }
    :global(:root:not([data-theme])) .choice-tag { color: var(--status-success-light); }
  }
  .section-first .wrap { display: flex; flex-direction: column; gap: 20px; }
  .tour { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 40px; }
  .tour-stop { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 32px; align-items: center; }
  .tour-flip { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .tour-flip .tour-text { order: 2; }
  .tour-text { display: flex; flex-direction: column; gap: 10px; }
  .tour-text .label { margin: 0; }
  .tour-lead { margin: 0; font-size: 16px; line-height: 1.5; color: var(--fg); }
  .tour-text ul { margin: 0; color: var(--fg-2); display: flex; flex-direction: column; gap: 4px; }
  .tour-files-body { margin: 0; color: var(--fg-2); max-width: 80ch; }
  .plan-chip { font-family: var(--font-mono); font-size: 10.5px; border: 1px solid var(--hair-strong); border-radius: 4px; padding: 1px 6px; color: var(--fg-2); }
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .plan { display: flex; flex-direction: column; gap: 6px; padding: 22px 22px 20px; }
  .plan .label { margin: 0; }
  .plan-mid { border-color: var(--accent); }
  .plan-price { margin: 6px 0 0; display: flex; align-items: baseline; gap: 8px; color: var(--fg-2); font-size: 13.5px; }
  .plan-price strong { font-size: 38px; line-height: 1; color: var(--fg); letter-spacing: -.02em; }
  .plan-annual { margin: 0; color: var(--fg-3); }
  .plan-fit { margin: 8px 0 0; color: var(--fg-2); }
  .plan-lead { margin: 0; color: var(--fg); font-weight: 600; }
  .plan-list { margin: 8px 0 0; padding: 0; list-style: none; color: var(--fg-2); display: flex; flex-direction: column; gap: 6px; }
  .plan-list li { padding-left: 20px; position: relative; }
  .plan-list li::before { content: '✓'; position: absolute; left: 0; color: var(--status-success); }
  :global([data-theme="light"]) .plan-list li::before { color: var(--status-success-light); }
  /* comparison: what each higher plan adds is tinted, included is a green check, not included a quiet dash */
  .compare-wrap { position: relative; min-width: 0; overflow-x: auto; border: 1px solid var(--hair); border-radius: var(--r-card); background: var(--bg-raised); }
  .compare { width: 100%; min-width: 600px; border-collapse: collapse; font-size: 13.5px; }
  .compare th, .compare td { padding: 10px 16px; text-align: left; border-bottom: 1px solid var(--hair); }
  .compare thead th { vertical-align: bottom; padding-top: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--hair-strong); }
  .compare thead th:first-child { width: 40%; }
  .compare-note { font-size: 12px; font-weight: 400; color: var(--fg-3); }
  .compare-plan { display: block; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--fg-3); font-weight: 500; }
  .compare-price { display: block; margin-top: 4px; font-size: 22px; font-weight: 700; color: var(--fg); }
  .compare-price small { font-size: 12px; font-weight: 400; color: var(--fg-3); margin-left: 3px; }
  .compare tbody th { font-weight: 500; color: var(--fg); }
  .compare td { color: var(--fg-2); }
  .compare .compare-group th { padding-top: 18px; padding-bottom: 6px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .06em; color: var(--fg-3); }
  .compare tbody:last-child tr:last-child > * { border-bottom: 0; }
  .compare .is-pro { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .compare td.is-gain { color: var(--fg); font-weight: 600; background: color-mix(in srgb, var(--status-success) 14%, transparent); }
  /* on narrow screens the table scrolls under a pinned capability column */
  @media (max-width: 760px) { .compare tbody th, .compare thead th:first-child { position: sticky; left: 0; z-index: 1; background: var(--bg-raised); min-width: 170px; } .compare .compare-group th { position: static; } }
  .compare-yes { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; color: var(--status-success); background: color-mix(in srgb, var(--status-success) 16%, transparent); }
  .compare-yes :global(svg *) { stroke-width: 3; }
  .compare-no { display: inline-flex; color: var(--fg-3); opacity: .6; }
  :global([data-theme="light"]) .compare-yes { color: var(--status-success-light); background: color-mix(in srgb, var(--status-success-light) 14%, transparent); }
  :global([data-theme="light"]) .compare td.is-gain { background: color-mix(in srgb, var(--status-success-light) 10%, transparent); }
  .history-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .history-body, .data-body { margin: 0; color: var(--fg-2); }
  .history-standing { margin: 0; }
  .perms-wrap { overflow-x: auto; }
  .perms { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .perms th { text-align: left; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--fg-3); font-weight: 500; padding: 8px 10px; border-bottom: 1px solid var(--hair); }
  .perms td { padding: 9px 10px; border-bottom: 1px solid var(--hair); vertical-align: top; color: var(--fg-2); }
  .perms td:first-child { font-weight: 600; color: var(--fg); white-space: nowrap; }
  .perms-foot { margin: 4px 0 0; }
  .migrate-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  @media (max-width: 1000px) { .history-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tour-stop, .tour-flip { grid-template-columns: minmax(0, 1fr); gap: 16px; } .tour-flip .tour-text { order: 0; } .plans { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 900px) { .migrate-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; } }
  @media (max-width: 640px) { .history-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
