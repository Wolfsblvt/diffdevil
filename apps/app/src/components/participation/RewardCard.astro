---
// SPDX-License-Identifier: AGPL-3.0-only WITH AdditionRef-diffdevil-premium-interface-exception-1.0
// The participation reward where the customer manages Pro: its one standing, the alternatives in Wirt's terms, the
// confirmed applications, the next charge or a requested continuation preview as receipts, and the way to the survey.
// Everything numeric comes from Wirt. A preview is a Works quote, so it is requested by the person's own POST (the
// Monthly and Annual buttons); the page then shows the stored answer and never creates a quote by being viewed.
import Icon from '../Icon.astro';
import Receipt from './Receipt.astro';
interface Props { card: any; surveyLink?: boolean; next?: any; quote?: any; depart?: string | null }
const { card, surveyLink = true, next = null, quote = null, depart = null } = Astro.props;
const STANDING: Record<string, string> = { available: 'Open', accepted: 'Applies next', queued: 'Queued', active: 'Active', waiting: 'Waiting', exercised: 'Acquired', ended: 'Ended', withdrawn: 'Withdrawn', reserved: 'Reserved', retired: 'Set aside', 'partially-consumed': 'In use', consumed: 'Used', expired: 'Expired', corrected: 'Corrected' };
const ICON: Record<string, string> = { ok: 'gift', warn: 'alert-triangle', muted: 'clock', info: 'gift' };
const choosing = card.previewCadences?.length > 0;
const answering = ['invite', 'draft'].includes(card.key);
---
<section class:list={['m-sec', 'p-reward', `tone-${card.tone}`]} data-reward={card.key} aria-labelledby="p-reward-title">
  <header><h2 id="p-reward-title"><Icon name={ICON[card.tone] ?? 'gift'} size={16} /> {card.title}</h2><span class="d">{card.reason}</span></header>
  <div class="b">
    {card.lines.map((line: string) => <p class="p-line">{line}</p>)}
    {card.stale && <p class="m-note" data-reward-stale>Works can't be reached right now, so this is the standing it last sent.</p>}
    {card.alternatives.length > 0 && <ul class="p-alts" aria-label="Reward alternatives">{card.alternatives.map((alternative: any) => <li data-alternative={alternative.cadence} data-standing={alternative.standing}>
      <b>{alternative.label}</b><span>{alternative.terms}{['partially-consumed', 'reserved'].includes(alternative.standing) && alternative.remaining !== null ? ` · ${alternative.remaining} remaining` : ''}</span><span class="st">{STANDING[alternative.standing] ?? 'Unknown'}</span></li>)}</ul>}
    {next && <Receipt receipt={next} title="Your next charge" />}
    {choosing && <div class="p-preview"><span class="m-k">See the price with your reward</span>
      <form class="m-form" method="post" action="/manage/do" data-preview-form><input type="hidden" name="action" value="reward-preview" />
        <div class="a-seg sm" role="group" aria-label="Preview a Pro continuation">{card.previewCadences.map((cadence: string) => <button type="submit" name="cadence" value={cadence} aria-pressed={quote?.cadence === cadence ? 'true' : 'false'}>{cadence === 'monthly' ? 'Monthly' : 'Annual'}</button>)}</div></form>
      <span class="m-note" style="margin:0">A preview is Works' own quote. It reserves nothing.</span></div>}
    {quote?.receipt && <div data-preview={quote.cadence}><Receipt receipt={quote.receipt} title={`Pro ${quote.cadence} with your reward`} />
      {depart && <div class="m-acts" style="margin-top:10px"><a class="m-btn pri" href={depart}>Continue with Pro at Works <Icon name="arrow-up-right" size={13} /></a><span class="m-note" style="margin:0">Accepting there reserves this discount for that payment.</span></div>}</div>}
    {card.applications.length > 0 && <div class="p-applied"><span class="m-k">Applied so far{card.realOccurrenceDates ? ' · real dates' : ''}</span><ul>{card.applications.map((application: any) => <li><span>{application.on ?? 'Confirmed charge'}</span><b>−{application.amount}</b><span class="d">{application.remainingAfter === null ? '' : application.remainingAfter === 0 ? 'the last discounted charge' : `${application.remainingAfter} remaining after it`}</span></li>)}</ul></div>}
    {surveyLink && <div class="m-acts p-acts">{answering ? <a class="m-btn pri" href="/manage/plan/survey">{card.key === 'draft' ? 'Finish the survey' : 'Take the survey'}</a> : <a class="m-btn ghost sm" href="/manage/plan/survey">Your survey answers</a>}</div>}
  </div>
</section>
