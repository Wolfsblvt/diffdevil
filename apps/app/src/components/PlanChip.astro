---
// SPDX-License-Identifier: AGPL-3.0-only WITH AdditionRef-diffdevil-premium-interface-exception-1.0
// A plan chip: Pro or Business, small and quiet, the same everywhere. Free renders nothing.
interface Props { plan: 'Free' | 'Pro' | 'Business' | string }
const { plan } = Astro.props;
---
{plan !== 'Free' && <span class:list={['a-plan', { biz: plan === 'Business' }]}>{plan}</span>}
