---
// SPDX-License-Identifier: AGPL-3.0-only WITH AdditionRef-diffdevil-premium-interface-exception-1.0
import Panel from './Panel.astro';
import FilePath from './FilePath.astro';
import Icon from './Icon.astro';
import { describeBound, n0 } from '../lib/intervals.mjs';
const { retainedRow, retainedFiles, pathlessRows = [], pro, pending = false } = Astro.props;
const included = retainedRow ? retainedFiles.filter((file: any) => file.included).length : pathlessRows.filter((row: any) => row.inclusion === 'included').length;
const excluded = retainedRow ? retainedFiles.filter((file: any) => !file.included).length : pathlessRows.filter((row: any) => row.inclusion === 'excluded').length;
const inclusionUnknown = retainedRow ? 0 : pathlessRows.filter((row: any) => !['included', 'excluded'].includes(row.inclusion)).length;
---
    <Panel id="pf" span={6} class="pr-files" title="Files" meta={retainedRow ? `${retainedFiles.length} observed · ${included} included · ${excluded} excluded by policy · base file facts of this comparison` : `${pathlessRows.length} observed · ${inclusionUnknown === pathlessRows.length ? 'policy scope not recorded by this analysis version' : `${included} included · ${excluded} excluded by policy${inclusionUnknown ? ` · ${inclusionUnknown} scope not recorded` : ''}`} · paths are not retained in pathless history`}>
      {pending && <><p class="a-mini" role="status" data-region-status>Loading file-history links. The base file facts remain available.</p><button class="btn btn-quiet" type="button" data-premium-retry hidden>Retry file-history links</button></>}
      {retainedRow ? (retainedFiles.length === 0 ? <p class="a-mini">This comparison retained no per-file rows.</p> : <div class="pr-files-scroll" role="region" aria-label="File comparison table" tabindex="0"><table class="a-tbl named"><thead><tr><th>Path</th><th>Policy</th><th class="r">Changed</th><th class="r" title="Raw churn" aria-label="Raw churn">Raw</th></tr></thead><tbody>
        {retainedFiles.map((file: any) => <tr class={file.included ? '' : 'excl'}><td title={file.path} aria-label={file.path}>{file.href ? <a href={file.href} title={file.path} aria-label={file.path}><FilePath path={file.path} title={file.path} middleEllipsis /></a> : <FilePath path={file.path} title={file.path} middleEllipsis />}</td><td class="a-mini">{file.included ? <Icon name="check" size={13} label="Included in policy scope" /> : 'excluded'}</td><td class="r"><span class="a-chg"><span class="n">{describeBound(file.changed)}</span></span></td><td class="r a-mini">{describeBound(file.rawChurn)}</td></tr>)}
      </tbody></table></div>)
      : (pathlessRows.length === 0 ? <p class="a-mini">This analysis retained no per-file rows.</p> : <div class="pr-files-scroll" role="region" aria-label="File comparison table" tabindex="0"><table class="a-tbl"><thead><tr><th>File</th><th>Policy scope</th><th>Change</th><th class="r">Changed</th><th style="width:90px"></th><th class="r">Raw</th></tr></thead><tbody>
        {pathlessRows.map((row: any) => <tr class={row.inclusion === 'excluded' ? 'excl' : ''}><td><span class="a-path"><span class="dir">file </span>{row.ordinal + 1}</span><span class="a-mini"> · path not retained</span></td><td class="a-mini">{['included', 'excluded'].includes(row.inclusion) ? row.inclusion : 'not recorded'}</td><td class="a-mini">{row.changeType}{row.material === 'binary' ? ' · binary' : ''}</td><td class="r">{row.changed.status === 'unknown' && (row.changed.lower ?? 0) === 0 ? <span class="a-mini">{row.evidence === 'unmeasurable' ? 'not measurable' : 'unknown'}</span> : <span class="a-chg"><span class="n">{describeBound(row.changed)}</span>{row.changed.status === 'exact' && <span class="d"><span class="p">+{n0(row.added.lower)}</span><span class="x">−{n0(row.deleted.lower)}</span><span class="t">~{n0(row.modified.lower)}</span></span>}</span>}</td><td>{row.changed.status === 'exact' && row.changed.lower > 0 && <div class="a-split" style="height:6px"><i style={`flex:${row.modified.lower};background:var(--a-mod)`}></i><i style={`flex:${row.added.lower};background:var(--a-add)`}></i><i style={`flex:${row.deleted.lower};background:var(--a-del)`}></i></div>}</td><td class="r a-mini" style="white-space:nowrap">+{describeBound(row.rawAdded)} −{describeBound(row.rawDeleted)}</td></tr>)}
      </tbody></table></div>)}
      <p class="a-mini" style="margin:10px 0 0">{retainedRow ? (pro && !pending ? 'Each file links to its history; a file-detail address is an opaque handle, never the path.' : 'File names are base facts of this comparison; file history, sizes and co-change are Pro.') : 'Per-file rows keep an ordinal local to this analysis, never a path, name or author. Named files arrive as the App retains final merged comparisons for this repository.'}</p>
    </Panel>
