export const partial = true;
import Invitation from '../../components/participation/Invitation.astro';
import { manageBadge } from '../../lib/manage/model.mjs';
const badge = await manageBadge({ viewer: Astro.locals.viewer, session: Astro.locals.session, runtime: Astro.locals.app });
