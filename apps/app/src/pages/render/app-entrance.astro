---
// SPDX-License-Identifier: AGPL-3.0-only WITH AdditionRef-diffdevil-premium-interface-exception-1.0
// Neutral task entrance, selected only by the root request's middleware. No viewer or analytics is read here.
import '../../../../website/src/styles/fonts.css';
import '../../../../website/src/styles/tokens.css';
import '../../../../website/src/styles/global.css';
import '../../styles/app.css';
import Icon from '../../components/Icon.astro';
import InstallHead from '../../components/InstallHead.astro';
import { siteHeader } from '../../lib/shell.mjs';
import { STATUS_URL } from '../../../../website/public-origins.mjs';
const origin = Astro.locals.app?.config?.origin ?? Astro.site?.origin;
const siteOrigin = Astro.locals.app?.config?.siteOrigin ?? 'https://diffdevil.dev';
const header = await siteHeader(Astro.locals, origin);
const canonical = `${origin}/`;
const description = 'Understand change across your repositories with diffdevil: pull-request activity, repository history and shared policy under your current GitHub access.';
const staging = import.meta.env.DIFFDEVIL_APP_TARGET === 'staging';
---
<!doctype html>
<html lang="en" data-theme="dark" data-theme-pref="dark" data-theme-next="light" data-theme-locked>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{staging ? 'Staging · diffdevil App' : 'diffdevil App'}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151922" /><meta name="color-scheme" content="dark" />
    {staging && <meta name="robots" content="noindex, nofollow, nosnippet" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <InstallHead />
    <meta property="og:site_name" content="diffdevil App" /><meta property="og:title" content="diffdevil App" />
    <meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={`${origin}/icon-512.png`} />
    <meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="512" /><meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="The diffdevil application mark." />
    <meta name="twitter:card" content="summary" /><meta name="twitter:title" content="diffdevil App" />
    <meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${origin}/icon-512.png`} />
    <meta name="twitter:image:alt" content="The diffdevil application mark." />
  </head>
  <body class="app-route">
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Fragment set:html={header} />
    <main id="main" class="a-signin" data-public-app-entrance>
      <section class="a-pn a-signin-card"><div class="a-pn-b">
        <p class="eyebrow eyebrow-caps">diffdevil App</p>
        <h1>diffdevil, with a memory.</h1>
        <p class="lede">Understand how your repositories change. Follow pull-request activity, explore retained repository history, and see the policy behind each result.</p>
        <p>Sign in with GitHub to see connected repositories you can already access. An administrator chooses which repositories run and whether to retain history. Signing in grants no new repository authority and starts no collection.</p>
        <a class="btn btn-primary btn-l" href="/auth/start" rel="nofollow"><Icon name="github" size={16} />Sign in with GitHub</a>
        <p class="a-mini a-signin-foot"><a href={`${siteOrigin}/app/`}>About the diffdevil App</a> · <a href="https://docs.diffdevil.dev/use/managed-app/">App guide</a> · <a href={`${siteOrigin}/privacy/`}>Privacy</a> · <a href={STATUS_URL}>Status</a></p>
      </div></section>
    </main>
    <div class="live" role="status" aria-live="polite" data-live-region></div>
    <script>import '../../client/app';</script>
  </body>
</html>
