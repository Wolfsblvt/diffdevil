---
// SPDX-License-Identifier: AGPL-3.0-only WITH AdditionRef-diffdevil-premium-interface-exception-1.0
// A stand-in for the Wirt-hosted destinations, served only when the loopback commercial fixture is active: the real
// pages open at account.wolfsblvt.works in the diffdevil frame. Its buttons simulate what Works would have done before
// the person returns to diffdevil's one admitted manage-plan destination.
import AppShell from '../../layouts/AppShell.astro';
import ActionForm from '../../components/manage/ActionForm.astro';
const runtime = Astro.locals.app;
if (runtime.commercialSource !== 'fixture') return new Response('Not found', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' } });
const dest = Astro.url.searchParams.get('dest') ?? 'experience';
const link = dest === 'link';
---
<AppShell title="Works stand-in">
  <section class="m-sec" style="max-width:560px;margin:40px auto" data-works-stand-in={dest}>
    <header><h2>{link ? 'Choose your plan' : 'Manage your plan'} <span class="m-none">at Wolfsblvt Works · stand-in</span></h2></header>
    <div class="b">
      <p class="m-lede">{link ? 'Local stand-in for the first upgrade. At Works you would sign in, approve linking this diffdevil account, and diffdevil would forward you straight to Works\' diffdevil plan page.' : `Local stand-in for Wirt's /diffdevil/manage-plan/${dest} page. Return to diffdevil lands on diffdevil's one admitted manage-plan destination; diffdevil itself remembers what you were doing.`}</p>
      <div class="m-acts" style="margin-top:14px">
        {link
          ? <><ActionForm action="fixture-simulate" fields={{ kind: 'link-complete' }} label="Continue: linked, now the plan page" class="pri" back="/manage/plan" /><a class="m-btn" href="/manage/plan?works-link=pending">Simulate: link didn't finish</a></>
          : <><ActionForm action="fixture-simulate" fields={{ kind: 'nothing' }} label="Return after paying (unconfirmed)" class="pri" back="/manage/plan" /><ActionForm action="fixture-simulate" fields={{ kind: 'add-slot' }} label="…after Works confirmed a new slot" back="/manage/plan" /><ActionForm action="fixture-simulate" fields={{ kind: 'pay' }} label="…after Works confirmed payment" back="/manage/plan" /><ActionForm action="fixture-simulate" fields={{ kind: 'reduce-to-free' }} label="…after the plan ended (its date passed)" back="/manage/plan" /><a class="m-btn ghost" href="/manage/plan">Return to diffdevil</a></>}
      </div>
      {!link && runtime.participation && <div data-stand-in-reward style="margin-top:18px"><span class="m-k">Participation reward · what Works would do</span>
        <div class="m-acts" style="margin-top:8px;flex-wrap:wrap">
          {[['reward-reserve:monthly', 'Accept a monthly quote'], ['reward-reserve:annual', 'Accept an annual quote'], ['reward-confirm', 'Confirm that payment'], ['reward-release', 'That payment failed'], ['reward-renew', 'Confirm a renewal'], ['reward-expire', 'Expire the reward'], ['reward-correct', 'Correct the reward'], ['wirt:unavailable', 'Works stops answering'], ['wirt:recorded', 'Works answers again']].map(([kind, label]) => <ActionForm action="fixture-simulate" fields={{ kind }} label={label} class="sm" back="/manage/plan" />)}
        </div></div>}
    </div>
  </section>
</AppShell>
