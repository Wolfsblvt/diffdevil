{
  // Source configuration for the signed-in App Worker. The adapter supplies `main` and the
  // assets binding at build time. The D1 database is the managed App's own database; its
  // real identifier, the OAuth client secret and the seal key are operator inputs supplied
  // outside source (`wrangler secret` / `.dev.vars`), never committed here.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "diffdevil-app",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "https://app.diffdevil.dev",
    "SITE_ORIGIN": "https://diffdevil.dev",
    "APP_SESSION_DAYS": "30"
  },
  "d1_databases": [{
    "binding": "APP_DB",
    "database_name": "diffdevil-github-app",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../github-app/migrations"
  }]
}
