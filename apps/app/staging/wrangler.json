{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "diffdevil-app-staging",
  "main": "../src/worker.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "APP_STAGING_INSTALLATION_ACCOUNT_IDS": "[9962104,341708115]",
    "APP_ORIGIN": "https://app-staging.diffdevil.dev",
    "SITE_ORIGIN": "https://diffdevil.dev",
    "APP_SESSION_DAYS": "30",
    "GITHUB_APP_BOT_LOGIN": "diffdevil-staging[bot]",
    "WIRT_ORIGIN": "https://wirt-test.wolfsblvt.app",
    "WIRT_OAUTH_CLIENT_ID": "01a136df-f666-70e6-9876-ce292de127c8",
    "WIRT_LINK_CALLBACK_URL": "https://app-staging.diffdevil.dev/integrations/wirt/link/callback",
    "WIRT_LINK_CONTINUATION_URL": "https://app-staging.diffdevil.dev/manage/plan"
  },
  "d1_databases": [{
    "binding": "APP_DB",
    "database_name": "diffdevil-github-app-staging",
    "database_id": "6f952779-bd44-42de-adf7-cc03709c8222",
    "migrations_dir": "../../github-app/migrations"
  }],
  "queues": {
    "producers": [{ "binding": "APP_QUEUE", "queue": "diffdevil-github-app-staging-work" }],
    "consumers": [{
      "queue": "diffdevil-github-app-staging-work",
      "max_batch_size": 10,
      "max_batch_timeout": 30,
      "max_retries": 5,
      "retry_delay": 60,
      "dead_letter_queue": "diffdevil-github-app-staging-dlq"
    }]
  }
}
