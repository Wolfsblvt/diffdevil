{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "diffdevil-app-staging",
  "main": "../src/worker.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "APP_ORIGIN": "https://diffdevil-app-staging.invalid",
    "SITE_ORIGIN": "https://diffdevil.dev",
    "APP_SESSION_DAYS": "30",
    "GITHUB_APP_BOT_LOGIN": "staging-bot-login-required[bot]",
    "WIRT_ORIGIN": "https://wirt-staging.invalid",
    "WIRT_OAUTH_CLIENT_ID": "staging-client-registration-required",
    "WIRT_LINK_CALLBACK_URL": "https://diffdevil-app-staging.invalid/integrations/wirt/link/callback",
    "WIRT_LINK_CONTINUATION_URL": "https://diffdevil-app-staging.invalid/manage/plan"
  },
  "d1_databases": [{
    "binding": "APP_DB",
    "database_name": "diffdevil-github-app-staging",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../../github-app/migrations"
  }],
  "queues": {
    "producers": [{ "binding": "APP_QUEUE", "queue": "diffdevil-github-app-staging-work" }],
    "consumers": [{
      "queue": "diffdevil-github-app-staging-work",
      "max_batch_size": 10,
      "max_batch_timeout": 30,
      "max_retries": 5,
      "retry_delay": 60,
      "dead_letter_queue": "diffdevil-github-app-staging-dlq"
    }]
  }
}
