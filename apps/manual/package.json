{
  "name": "diffdevil-public-manual",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "toolchain": "node ../../tools/manual-package.mjs",
    "build": "node ../../tools/public-build.mjs",
    "check": "npm --prefix ../.. run build && node ../../tools/manual-command.mjs check",
    "dev": "npm --prefix ../.. run build && node ../../tools/manual-command.mjs dev",
    "test": "node --test *.test.mjs",
    "test:projection": "node --test render.spec.mjs",
    "qa": "node ../../tools/manual-qa.mjs",
    "verify:offline": "node ../../tools/verify-offline.mjs",
    "generate": "npm --prefix ../.. run build && node generated-content.mjs --write",
    "check:generated": "node generated-content.mjs --check"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.2",
    "@wolfsblvt/starlight-works": "file:../../artifacts/manual-toolchain/package",
    "astro": "7.3.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "github-slugger": "2.0.0"
  }
}
