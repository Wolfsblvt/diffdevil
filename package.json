{
  "name": "@wolfsblvt/diffdevil",
  "version": "1.0.0",
  "description": "Composable Git diff analysis and policy for Node.js, CI pipelines, and GitHub Actions.",
  "type": "module",
  "scripts": {
    "check:prep": "node ./tools/check-prep.mjs",
    "build": "node tools/build.mjs",
    "build:offline": "npm run build",
    "test": "node tools/browser-extension-build.mjs --without-fonts && node tools/test.mjs",
    "verify": "npm run check:prep && npm run build && npm test && npm run test:release && npm run check:actions && npm run check:workers && npm run check:github-app && npm run check:website && npm run extension:check && node tools/browser-extension-build.mjs",
    "verify:offline": "npm run verify",
    "test:package": "node tools/package-smoke.mjs",
    "prepack": "npm run build",
    "demo:shortcuts": "node tools/shortcut-demo.mjs",
    "test:conformance": "node tools/conformance.mjs",
    "build:actions": "npm run build && node tools/build-actions.mjs",
    "build:release": "npm run build && node tools/build-release.mjs",
    "test:release": "node tools/release-smoke.mjs",
    "check:actions": "node tools/build-actions.mjs --check",
    "test:actions": "node tools/action-smoke.mjs",
    "playground": "npm run build && node apps/playground/server.mjs",
    "playground:worker": "npm run build && node tools/run-wrangler.mjs dev --local",
    "check:workers": "node tools/run-wrangler.mjs deploy --dry-run --outdir artifacts/wrangler-dry-run",
    "check:github-app": "node tools/run-wrangler.mjs deploy --dry-run --config apps/github-app/wrangler.jsonc --outdir ../../artifacts/github-app-wrangler-dry-run && node tools/github-app-runtime-smoke.mjs",
    "website:assets": "node tools/website-assets.mjs",
    "website:docs": "node tools/website-docs.mjs --report",
    "website:build": "npm run build && npm run website:assets && npm run website:docs && astro build --root apps/website",
    "website:dev": "npm run build && npm run website:assets && npm run website:docs && astro dev --root apps/website",
    "website:preview": "astro preview --root apps/website",
    "website:check": "node tools/website-docs.mjs && astro sync --root apps/website && node tools/website-typecheck.mjs apps/website",
    "check:website": "node tools/website-assets.mjs && node tools/website-docs.mjs && astro build --root apps/website",
    "test:website": "node --test apps/website/website.test.mjs",
    "qa:website": "node apps/website/qa/run.mjs",
    "extension:dev": "npm run extension:build",
    "extension:build": "npm run build && npm run extension:check && node tools/browser-extension-build.mjs",
    "extension:check": "node node_modules/typescript/bin/tsc -p apps/browser-extension/tsconfig.json --pretty false",
    "extension:test": "node tools/browser-extension-build.mjs --without-fonts && node --test apps/browser-extension/tests/*.test.mjs",
    "extension:qa": "node apps/browser-extension/qa/run.mjs && node apps/browser-extension/qa/acquisition.mjs",
    "extension:qa:installed": "node apps/browser-extension/qa/installed.mjs",
    "extension:store": "node tools/browser-extension-store.mjs"
  },
  "keywords": [
    "git",
    "diff",
    "github-actions",
    "ci",
    "policy",
    "pull-request",
    "typescript"
  ],
  "author": "Wolfsblvt Works",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "bin": {
    "diffdevil": "./dist/lib/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./core": {
      "types": "./dist/lib/core.d.ts",
      "import": "./dist/lib/core.js"
    },
    "./language": {
      "types": "./dist/lib/language/index.d.ts",
      "import": "./dist/lib/language/index.js"
    },
    "./policy": {
      "types": "./dist/lib/policy/index.d.ts",
      "import": "./dist/lib/policy/index.js"
    },
    "./git": {
      "types": "./dist/lib/sources/git.d.ts",
      "import": "./dist/lib/sources/git.js"
    },
    "./package.json": "./package.json",
    "./github": {
      "types": "./dist/lib/github/index.d.ts",
      "import": "./dist/lib/github/index.js"
    },
    "./browser": {
      "types": "./dist/lib/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./browser/text": {
      "types": "./dist/lib/browser/text.d.ts",
      "import": "./dist/lib/browser/text.js"
    }
  },
  "files": [
    "dist/lib",
    "dist/browser",
    "src/diffdevil/**/*.ts",
    "src/diffdevil/contracts",
    "src/diffdevil/presets/*.yml",
    "docs",
    "skills",
    "LICENSES"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.6",
    "@astrojs/starlight": "0.42.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@iconify-json/lucide": "1.2.135",
    "@iconify-json/simple-icons": "1.2.97",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.3",
    "codemirror": "6.0.2",
    "miniflare": "5.20260915.0-alpha",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "chevrotain": "13.2.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolfsblvt/diffdevil.git"
  },
  "overrides": {
    "@astrojs/check": {
      "typescript": "$typescript"
    }
  }
}
